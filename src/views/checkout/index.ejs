<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Checkout Page</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link rel="stylesheet" href="../../../public/styles/homePage.css">
    <link rel="stylesheet" href="../../public/styles/checkout.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">
</head>

<body>
    <main>
        <div class="alert-box" id="alert-box">
            <div class="alert " id="alert">

            </div>
        </div>

        <section class="header-section">
            <div class="container-fluid d-flex justify-content-end">
                <div class="row">
                    <div class="col d-flex align-items-center">
                        <i class="fa fa-whatsapp  icon"></i>
                        <span class="text-lowercase  ">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-headset  icon"></i>
                        <span class="text-lowercase">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-comment-alt icon"></i>
                        <span class="text-capitalize">Chat</span>
                    </div>
                    <div class="col profile-container">
                        <% if(isLogin) { %>
                            <div class="btn-group">
                                <button type="button" class="btn  dropdown-toggle" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    <%= currentUser.firstName %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="/user/profile">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-regular fa-user"></i>
                                                </div>
                                                <div class="col">
                                                    Profile
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-solid fa-gear"></i>
                                                </div>
                                                <div class="col">
                                                    Settings
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                                </div>
                                                <div class="col">
                                                    Logout
                                                </div>
                                            </div>
                                        </a>
                                    </li>

                                </ul>

                            </div>
                            <%}else { %>
                                <span class="text-capitalize" style="cursor: pointer;"
                                    onclick="window.location.href='/auth/login'">Login</span>
                                <%}%>
                    </div>
                </div>
            </div>
            </div>
        </section>

        <section class="logo-section py-2 ">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <!-- Logo Section -->
                <div class="d-flex align-items-center logo-text-container w-100">
                    <img src="../../public/asstes/images/logo.jpg" class="logo-image me-2" style="height: 50px;"
                        alt="Logo" />
                    <a href="/" class="logo-text-container w-100" style="text-decoration: none;">
                        <h5>ACTIVE CROP</h5>
                    </a>
                </div>

                <!-- Search Bar & Cart Section -->
                <div class="d-flex align-items-center  text-white p-2 rounded w-50 justify-content-between">
                    <!-- Search Bar -->
                    <form class="d-flex w-75" method="get">
                        <input class="form-control me-2" type="search" placeholder="Search..." aria-label="Search">
                        <button class="btn btn-outline-success" type="submit">Search</button>
                    </form>

                    <!-- Cart Icon with Badge -->
                    <div class="position-relative">
                        <i class="fa fa-shopping-cart fa-2x text-secondary"></i>
                        <% if (isLogin){ %>
                            <span
                                class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cartLength %>
                                    <span class="visually-hidden">unread messages</span>
                            </span>
                            <%} %>

                    </div>
                </div>
            </div>
        </section>

        <section class="main-container">
            <div class="checkout-container">
                <div class="container my-5">
                    <h2 class="text-center mb-4">Checkout</h2>

                    <div class="row">
                        <!-- Address Selection Area -->
                        <div class="col-md-6 mb-4">
                            <div class="card">
                                <div class="card-header">Select Address</div>
                                <% if (addressList.length>0){%>

                                    <div class="card-body">
                                        <% addressList.forEach(function(address){%>
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="address"
                                                    id="address1" value="<%= address._id %>">
                                                <label class="form-check-label" for="address1">
                                                    <%= address.nickname %><br>
                                                        <%= address.address_line_1 %><br>
                                                            <%= address.address_line_2 %><br>
                                                                <%= address.pincode %>
                                                </label>
                                                <input type="hidden" value="<%= address._id %>" id="address-id" />
                                            </div>
                                            <% })%>
                                                <% }else{ %>
                                                    <div class="card-body">
                                                        <p>Add New Address</p>
                                                    </div>
                                                    <% }%>

                                                        <button class="btn btn-outline-primary w-100"
                                                            onclick="window.location.href='/user/profile/address/create'">Add
                                                            New
                                                            Address</button>
                                    </div>
                            </div>
                        </div>

                        <!-- Cart Details -->
                        <div class="col-md-6 mb-4">
                            <div class="card">
                                <div class="card-header">Cart Details</div>
                                <div class="card-body">
                                    <ul class="list-group mb-3">
                                        <% cart.items.forEach(function(item){ %>
                                            <li class="list-group-item d-flex justify-content-between">
                                                <div>
                                                    <%= item.product_name %>
                                                </div>
                                                <span>
                                                    <%= item.priceAtPurchanse %>
                                                </span>
                                            </li>
                                            <% })%>
                                    </ul>
                                    <div class="d-flex justify-content-between">
                                        <strong>Total Items:</strong>
                                        <span>
                                            <%= cart.items.length %>
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <strong>Total Price:</strong>
                                        <span>
                                            <%= cart.total_price + 100%>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Coupon Apply Area -->
                    <div class="card mb-4">
                        <div class="card-header">Apply Coupon</div>
                        <div class="card-body d-flex">
                            <input type="text" class="form-control me-2" placeholder="Enter coupon code">
                            <button class="btn btn-success">Apply</button>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="card mb-4">
                        <div class="card-header">Payment Method</div>
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="cod" checked>
                                <label class="form-check-label" for="cod">Cash on Delivery (COD)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Place Order Button -->
                    <div class="text-center">
                        <button class="btn btn-primary btn-lg" onclick="placeOrder('<%= cart._id %>')">Place
                            Order</button>
                    </div>
                </div>
            </div>
        </section>


        <section class="footer-section">
            <div class="footer-container">
                <div class="contianer">
                    <div class="row">
                        <div class="col aboutus-container">
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col col-items">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>

                        </div>
                        <div class="col col-items ">
                            <h5>Useful Links</h5>
                            <ul>
                                <li>Privacy Policy</li>
                                <li>Refun & Refund Policy</li>
                                <li>Ship and Delivery policy</li>
                                <li>Terms & Condtitions</li>
                                <li>Disclaimer</li>
                                <li>Carrers</li>
                            </ul>

                        </div>
                    </div>
                </div>
            </div>
            <div class="copy-right-contianer">
                <h5 class="text-center text-white">Copyrights@activeCrop</h5>
            </div>
        </section>

    </main>

    <script>

        const alertMessage = document.getElementById('alert')
        function placeOrder(cartId) {
            // Get selected address
            const selectedAddress = document.querySelector('input[name="address"]:checked');
            if (!selectedAddress) {
                alert('Please select an address.');
                return;
            }
            const addressId = selectedAddress.value;

            const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').id;


            // Data to send
            const orderData = {
                addressId,
                cartId,
                paymentMethod
            };
            // Send data to server
            fetch('/orders/place-order', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(orderData)
            })
                .then(response => response.json())
                .then(data => {
                    alertMessage.classList.add(data.alertType)
                    alertMessage.innerText = data.message

                    setTimeout(() => {
                        alertMessage.classList.remove(data.alertType)
                        alertMessage.innerText = ''
                        if (data.redirect) {
                            window.location.href = data.redirect
                        }
                    }, 3000)
                })
                .catch(error => console.error('Error:', error));
        }

    </script>
    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Active Crop | OTP Verify</title>
  <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon" />
  <link rel="stylesheet" href="../../../public/styles/userAuthStyle.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet" />
</head>

<body class="d-flex flex-coloumn">
  <div class="container-fluid vh-100 d-flex flex-column justify-content-center align-items-center position-relative">
    <div class="position-absolute top-0 end-0 mt-3 me-3" id="alert-box">
      <% if (alertMessage) { %>
        <div class="alert alert-<%= alertType %>" id="alert">
          <%= alertMessage %>
        </div>
        <% } %>
    </div>

    <section class="login-form-section">
      <div class="card">
        <img src="../../../public/asstes/images/logo.jpg" class="card-image" alt="logo" />
        <div class="card-body">
          <h5 class="card-title text-center">OTP Verify</h5>
  
          <form id="otpVerifyForm" method="post" action="/otp/verifyOtp">
            <div class="mb-3">
              <label for="otpVerify" class="form-label lable-text">OTP Verify</label>
              <input type="text" class="form-control" name="OtpVerify" id="otpVerify" maxlength="6"  />
            </div>
  
            <div class="btn-contianer mb-3">
              <button type="submit" class="btn">Verify OTP</button>
            </div>
  
            <a href="#" onclick="resendOtp(event)" id="resend-otp">Resend OTP</a>
  
            <p id="timer-display"></p>
          </form>
        </div>
      </div>
    </section>
  </div>




  <script>

    const alertBox = document.getElementById('alert-box')
    setTimeout(() => {
      alertBox.classList = '';
      alertBox.innerHTML = '';
    }, 3000);

    const redirectUrl = "<%= redirectUrl %>";
    if (redirectUrl && redirectUrl.trim() !== "") {
      setTimeout(() => {
        window.localStorage.removeItem('userName')
        window.location.href = redirectUrl;
      }, 2000)
    }


    let countdown;
    const timerDisplay = document.getElementById('timer-display');
    const initialTime = 5;
    const resendLink = document.getElementById('resend-otp')
    function startTimer() {

      resendLink.style.display = 'none';


      let timeLeft = 10;

      function formatTime(seconds) {
        const minutes = Math.floor(seconds / 60);
        const remainingSeconds = seconds % 60;
        return `${minutes}m ${remainingSeconds < 10 ? '0' : ''}${remainingSeconds}s`;
      }


      timerDisplay.textContent = `Resend OTP in ${formatTime(timeLeft)}`;


      if (countdown) {
        clearInterval(countdown);
      }


      countdown = setInterval(() => {
        timeLeft--;
        timerDisplay.textContent = `Resend OTP in ${formatTime(timeLeft)}`;
        if (timeLeft <= 0) {
          clearInterval(countdown);
          resendLink.style.display = 'block';
          timerDisplay.textContent = "You can now resend the OTP.";
        }
      }, 1000);
    }


    window.addEventListener('DOMContentLoaded', () => {
      startTimer();
    });

  //   document.getElementById('otpVerifyForm').addEventListener('submit', function(event) {
  //   var otpInput = document.getElementById('otpVerify');
  //   var errorMessage = document.getElementById('error-message');
  //   var otpValue = otpInput.value.trim();
    
  //   if (!/^[0-9]{6}$/.test(otpValue)) {
  //     event.preventDefault(); 
  //     errorMessage.style.display = 'block';
  //   } else {
  //     errorMessage.style.display = 'none';
      
  //   }
  // });


    async function resendOtp(event) {
      event.preventDefault();

      try {
        const response = await fetch('/otp/resentOtp', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            userName: window.localStorage.getItem('userName')
          })
        });

        const data = await response.json();
        const alertBox = document.getElementById('alert-box');
        if (response.ok) {
          alertBox.innerHTML = `
            <div class="alert alert-success">
              ${data.message}
            </div>
          `;

          startTimer();
        } else {
          alertBox.innerHTML = `
            <div class="alert alert-danger">
              ${data.message}
            </div>
          `;
        }
      } catch (error) {
        console.error('Error:', error);
        const alertBox = document.getElementById('alert-box');
        alertBox.innerHTML = `
          <div class="alert alert-danger">
            An error occurred while resending the OTP. Please try again.
          </div>
        `;
      }
    }
  </script>

  <!-- Bootstrap JS libraries -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
    integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
    integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
    crossorigin="anonymous"></script>
</body>

</html>
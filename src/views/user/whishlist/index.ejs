<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | WHishlist Page</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link rel="stylesheet" href="../../../public/styles/homePage.css">
    <link rel="stylesheet" href="../../../public/styles/cartPage.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">
</head>

<body>
    <main>
        <div class="alert-box" id="alert-box">
            <div class="alert " id="alert">

            </div>
        </div>

        <section class="header-section">
            <div class="container-fluid d-flex justify-content-end">
                <div class="row">
                    <div class="col d-flex align-items-center">
                        <i class="fa fa-whatsapp  icon"></i>
                        <span class="text-lowercase  ">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-headset  icon"></i>
                        <span class="text-lowercase">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-comment-alt icon"></i>
                        <span class="text-capitalize">Chat</span>
                    </div>
                    <div class="col profile-container">
                        <% if(isLogin) { %>
                            <div class="btn-group">
                                <button type="button" class="btn  dropdown-toggle" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    <%= currentUser.firstName %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="/user/profile">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-regular fa-user"></i>
                                                </div>
                                                <div class="col">
                                                    Profile
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-solid fa-gear"></i>
                                                </div>
                                                <div class="col">
                                                    Settings
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                                </div>
                                                <div class="col">
                                                    Logout
                                                </div>
                                            </div>
                                        </a>
                                    </li>

                                </ul>

                            </div>
                            <%}else { %>
                                <span class="text-capitalize" style="cursor: pointer;"
                                    onclick="window.location.href='/auth/login'">Login</span>
                                <%}%>
                    </div>
                </div>
            </div>
            </div>
        </section>


        <section class="logo-section py-2 ">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <!-- Logo Section -->
                <div class="d-flex align-items-center logo-text-container w-100">
                    <img src="../../public/asstes/images/logo.jpg" class="logo-image me-2" style="height: 50px;"
                        alt="Logo" />
                    <a href="/" class="logo-text-container w-100" style="text-decoration: none;">
                        <h5>ACTIVE CROP</h5>
                    </a>
                </div>

                <!-- Search Bar & Cart Section -->
                <div class="d-flex align-items-center  text-white p-2 rounded w-50 justify-content-between">
                    <!-- Search Bar -->
                    <form class="d-flex w-75" method="get">
                        <input class="form-control me-2" type="search" placeholder="Search..." aria-label="Search">
                        <button class="btn btn-outline-success" type="submit">Search</button>
                    </form>

                    <!-- Cart Icon with Badge -->
                    <div class="position-relative">
                        <div class="position-relative">
                            <i class="fa fa-shopping-cart fa-2x text-secondary" onClick="onCartClick()"></i>
                            <% if(isLogin){ %>
                                <span
                                    class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    <%=cartLength%>
                                        <span class="visually-hidden">unread messages</span>
                                </span>
                                <% } %>

                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="main-container">
            <div class="wishlist-section">
                <h2 class="text-start mb-4">💖 Your Wishlist</h2>

                <div id="wishlist-content">
                    <div class="row" id="wishlist-items">
                        <% if (wishlist && wishlist.items.length> 0) { %>
                            <% wishlist.items.forEach(function(item, index) { %>
                                <div class="col-md-8">
                                    <div class="card mb-3 shadow-sm position-relative d-flex"
                                        style="height: 15vh; overflow: hidden;">
                                        <div class="row g-0 align-items-center p-2 h-100 d-flex flex-nowrap">
                                            <div
                                                class="col-md-3 d-flex justify-content-center align-items-center h-100">
                                                <img src="/<%= item.product_image %>"
                                                    class="img-fluid rounded h-100 object-fit-contain"
                                                    alt="Product Image">
                                            </div>
                                            <div class="col-md-6 d-flex flex-column justify-content-center">
                                                <h5 class="card-title mb-1">
                                                    <%= item.product_name %>
                                                </h5>
                                                <p class="text-muted mb-1">Price: ₹<%= item.priceAtPurchase %>
                                                </p>
                                            </div>
                                            <div class="col-md-3 text-end d-flex flex-column align-items-end">
                                                <button class="btn btn-success btn-sm mb-2"
                                                    onclick="moveToCart('<%= wishlist._id %>','<%= item.product_id %>')">Move
                                                    to Cart</button>
                                                <button class="btn btn-danger btn-sm"
                                                    onclick="removeFromWishlist('<%= item.product_id %>')">Remove</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div id="empty-wishlist" class="text-center py-5">
                                            <h4>Your Wishlist is Empty!</h4>
                                            <p class="text-muted">Looks like you haven’t added anything to your wishlist
                                                yet.</p>
                                            <a href="/" class="btn btn-primary">Continue Shopping</a>
                                        </div>
                                        <% } %>
                    </div>

                </div>
            </div>
        </section>



        <section class="footer-section">
            <div class="footer-container">
                <div class="contianer">
                    <div class="row">
                        <div class="col aboutus-container">
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col col-items">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>

                        </div>
                        <div class="col col-items ">
                            <h5>Useful Links</h5>
                            <ul>
                                <li>Privacy Policy</li>
                                <li>Refun & Refund Policy</li>
                                <li>Ship and Delivery policy</li>
                                <li>Terms & Condtitions</li>
                                <li>Disclaimer</li>
                                <li>Carrers</li>
                            </ul>

                        </div>
                    </div>
                </div>
            </div>
            <div class="copy-right-contianer">
                <h5 class="text-center text-white">Copyrights@activeCrop</h5>
            </div>
        </section>

    </main>

    <script>
        function onCartClick() {
            const isLoggedIn = '<%= isLogin %>' === 'true'
            if (isLoggedIn) {
                window.location.href = '/user/cart'
            } else {
                window.location.href = '/auth/login'
            }
        }
        document.addEventListener('DOMContentLoaded', function () {
            fetch('/user/wishlist/get-wishlist')
                .then(response => response.json())
                .then(data => {
                    if (data.wishlist) {
                        renderWishlistItems(data.wishlist);
                    }
                });
        });

        function removeFromWishlist(productId) {
            fetch(`/whishlist/${productId}`, {
                method: 'DELETE'
            })
                .then(response => response.json())
                .then(data => {
                    if (data.wishlist) {
                        window.location.reload();
                    }
                });
        }

        function moveToCart(wishlist, productId) {
            fetch(`/whishlist/move-to-cart/${wishlist}/${productId}`, {
            })
                .then(response => response.json())
                .then(data => {
                    console.log(data)
                    if (data.cart) {
                        window.location.reload()
                        alertMessage.innerHTML = 'Added to Cart'
                        alertMessage.classList.add('alert-success')
                        setTimeout(() => {
                            alertMessage.innerHTML = ''
                            alertMessage.classList.remove('alert-success')
                            window.location.reload()
                        }, 2000)
                    }

                })
                .catch(error => {
                })
        }

    </script>
    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
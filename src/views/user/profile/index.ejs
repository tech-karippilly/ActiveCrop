                            </button>
                            <button type="button" class="list-group-item list-group-item-action">
                                Logout
                            </button>
                        </ul>
                    </div>
                </div>
                <div class="col-8 content-section">
                    <div class="display-container ">
                        <div class="profile-image-container">
                            <img id="profileImg" src="../../public/asstes/images/logo.jpg" class="profile-image"
                                alt="profile-image">
                            <label for="imageUpload" class="edit-icon" id="edit-icon">
                                <i class="fa-solid fa-pen"></i>
                            </label>
                            <input type="file" id="imageUpload" accept="image/*" style="display: none;">
                        </div>
                        <div class="contianer mt-3">
                            <div class="row mb-3">
                                <div class="col">
                                    <p>First Name</p>
                                </div>
                                <div class="col">
                                    <p id="first-name">First Name value</p>
                                    <input type="text" class="form-control" name="firstName" id="firstName" style="display: none;" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col">
                                    <p>Last Name</p>
                                </div>
                                <div class="col">
                                    <p id="last-name">Lat Name value</p>
                                    <input type="text" class="form-control"  name="lastName" id="lastName" style="display: none;" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col">
                                    <p>User Name</p>
                                </div>
                                <div class="col">
                                    <p id="user-name">User Name value</p>
                                    <input type="text" class="form-control" name="userName" id="userName" style="display: none;" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col">
                                    <p>Email </p>
                                </div>
                                <div class="col">
                                    <p id="email">Email value</p>
                                    <input type="email" class="form-control" name="email" id="useremail" style="display: none;" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col">
                                    <p>Phone </p>
                                </div>
                                <div class="col">
                                    <p id="user-phone">Phone value</p>
                                    <input type="tel" class="form-control" name="phone" id="userPhone" style="display: none;" />
                                </div>
                            </div>
                        </div>
                        <div class="container mt-3">
                            <div class="row">
                                <div class="col" id="edit-contianer">
                                    <button class="btn btn-primary" id="edit-button">Edit</button>
                                </div>
                                <div class="col">
                                    <button class="btn btn-danger" id="cancel-button">Cancel</button>
                                </div>
                                <div class="col">
                                    <button class="btn btn-success" id="save-button">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <section class="footer-section">
            <div class="footer-container">
                <div class="contianer">
                    <div class="row">
                        <div class="col aboutus-container">
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col col-items">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>

                        </div>
                        <div class="col col-items ">
                            <h5>Useful Links</h5>

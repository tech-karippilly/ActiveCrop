    <script>
        const alertBox = document.getElementById('alert-box')

        const imageEditIcon = document.getElementById('edit-icon')


        const editButton = document.getElementById('edit-button')
        const editButtonContainer = document.getElementById('edit-contianer')
        const cancelButton = document.getElementById('cancel-button')
        const saveButton = document.getElementById('save-button')
        imageEditIcon.style.display = 'none'
        cancelButton.style.display = 'none'
        saveButton.style.display = 'none'

        const firstNameLabel = document.getElementById('first-name')
        const lastNameLabel = document.getElementById('last-name')
        const userNameLabel = document.getElementById('user-name')
        const userEmailLabel = document.getElementById('email')
        const userPhoneLabel = document.getElementById('user-phone')

        const firstNameInput = document.getElementById('firstName')
        const lastNameInput = document.getElementById('lastName')
        const userNameInput = document.getElementById('userName')
        const userEmailInput = document.getElementById('useremail')
        const userPhoneInput = document.getElementById('userPhone')
        const userImageInput = document.getElementById('imageUpload')



        editButton.addEventListener('click', () => {
            imageEditIcon.style.display = 'flex'
            firstNameLabel.style.display = 'none'
            lastNameLabel.style.display = 'none'
            userNameLabel.style.display = 'none'
            userEmailLabel.style.display = 'none'
            userPhoneLabel.style.display = 'none'

            firstNameInput.style.display = 'block'
            lastNameInput.style.display = 'block'
            userNameInput.style.display = 'block'
            userEmailInput.style.display = 'block'
            userPhoneInput.style.display = 'block'
            editButton.style.display = 'none'
            editButtonContainer.style.display = 'none'
            cancelButton.style.display = 'block'
            saveButton.style.display = 'block'
        })
        cancelButton.addEventListener('click', () => {
            imageEditIcon.style.display = 'none'
            firstNameLabel.style.display = 'block'
            lastNameLabel.style.display = 'block'
            userNameLabel.style.display = 'block'
            userEmailLabel.style.display = 'block'
            userPhoneLabel.style.display = 'block'

            firstNameInput.style.display = 'none'
            lastNameInput.style.display = 'none'
            userNameInput.style.display = 'none'
            userEmailInput.style.display = 'none'
            userPhoneInput.style.display = 'none'

            editButton.style.display = 'block'
            editButtonContainer.style.display = 'flex'
            cancelButton.style.display = 'none'
            saveButton.style.display = 'none'
        })
        saveButton.addEventListener('click', () => {
            const fileInput = document.getElementById('imageUpload');
            const file = fileInput.files[0];

            let formData = new FormData();
            formData.append("firstName", firstNameInput.value);
            formData.append("lastName", lastNameInput.value);
            formData.append("userName", userNameInput.value);
            formData.append("email", userEmailInput.value);
            formData.append("phone", userPhoneInput.value);

            if (file) {
                formData.append("profileImage", file);
            }

            // fetch('/upload-endpoint', {
            //     method: 'POST',
            //     body: formData
            // })
            //     .then(response => response.json())
            //     .then(data => console.log("Upload success:", data))
            //     .catch(error => console.error("Upload error:", error));

            editButton.style.display = 'block';
        });


    </script>



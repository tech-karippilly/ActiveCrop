<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Wallet Page</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link rel="stylesheet" href="../../../public/styles/profile.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">
</head>

<body>
    <mian>
        <div class="alert-box" id="alert-box">
            <div class="alert " id="alert">

            </div>
        </div>
        <section class="header-section">
            <div class="container-fluid d-flex justify-content-end">
                <div class="row">
                    <div class="col d-flex align-items-center">
                        <i class="fa fa-whatsapp  icon"></i>
                        <span class="text-lowercase  ">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-headset  icon"></i>
                        <span class="text-lowercase">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-comment-alt icon"></i>
                        <span class="text-capitalize">Chat</span>
                    </div>
                    <div class="col profile-container">
                        <!-- <span class="text-capitalize" style="cursor: pointer;"
                            onclick="window.location.href='/auth/login'">Login</span> -->
                        <div class="btn-group">
                            <button type="button" class="btn  dropdown-toggle" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                VISHNU
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-regular fa-user"></i>
                                            </div>
                                            <div class="col">
                                                Profile
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-solid fa-gear"></i>
                                            </div>
                                            <div class="col">
                                                Settings
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                            </div>
                                            <div class="col">
                                                Logout
                                            </div>
                                        </div>

                        </div>

                        </a></li>
                        </ul>
                    </div>
                </div>
            </div>
            </div>
        </section>

        <section class="logo-section">
            <div class="container-fluid d-flex justify-content-end-start w-100 h-100">
                <div class="row w-25 h-100 ">
                    <div class="col h-100">
                        <img src="../../public/asstes/images/logo.jpg" class="logo-image" />
                    </div>

                    <div class="col h-100 logo-text-container">
                        <a href="/"  class="logo-text-container" style="text-decoration: none;">
                            <h5>ACTIVE CROP</h5>
                        </a>
                    </div>

                </div>
            </div>
        </section>

        <section class="container mt-5 ">
            <div class="row gap-2">
                <div class="col-3 side-menu-section">
                    <div class="header">
                        <h1>Profile</h1>
                    </div>
                    <div class="links-container">
                        <ul class="list-group list-group-flush">
                            <button type="button" onclick='window.location.href="/user/profile"'
                                class="list-group-item list-group-item-action " aria-current="true">
                                User Details
                            </button>
                            <button onclick='window.location.href="/user/profile/address"' type="button"
                                class="list-group-item list-group-item-action">
                                Address Management
                            </button>
                            <button type="button" class="list-group-item list-group-item-action" onclick="window.location.href='/user/profile/order'">
                                Orders
                            </button>
                            <button type="button" class="list-group-item list-group-item-action " onclick="window.location.href='/user/profile/wallet'">
                                Wallets
                            </button>
                            <button type="button" class="list-group-item list-group-item-action active" onclick="window.location.href='/user/profile/user-referal'">
                                Referal
                            </button>
                            <button type="button" class="list-group-item list-group-item-action"
                                onclick="window.location.href='/user/profile/password'">
                                Password
                            </button>
                            <button type="button" class="list-group-item list-group-item-action" onclick="window.location.href='/auth/logout'">
                                Logout
                            </button>
                        </ul>
                    </div>
                </div>
                <div class="col-8 content-section">
                    <div class="referral-container p-4 bg-light shadow rounded">
                        <h2 class="mb-4">Refer & Earn</h2>
                
                        <div class="referral-code-container text-center p-3 bg-white shadow-sm rounded">
                            <h5>Your Referral Code</h5>
                            <div class="d-flex justify-content-center align-items-center mt-2">
                                <span id="referral-code" class="fw-bold fs-4 px-3 py-2 border border-primary rounded"><%= referalDetails.referralCode %></span>
                                <button class="btn btn-primary ms-2" onclick="copyReferralCode()">Copy</button>
                            </div>
                        </div>
                
                        <div class="referral-link-container mt-4 p-3 bg-white shadow-sm rounded">
                            <h5>Share Your Referral Link</h5>
                            <div class="d-flex">
                                <input type="text" id="referral-link" class="form-control" value="<%= referalLink %>" readonly>
                                <button class="btn btn-primary ms-2" onclick="copyReferralLink()">Copy Link</button>
                            </div>
                        </div>
                
                        <div class="rewards-info mt-4 p-3 bg-white shadow-sm rounded">
                            <h4>How It Works</h4>
                            <ul>
                                <li>Share your referral code with friends.</li>
                                <li>Your friend gets ₹100 when they sign up using your code.</li>
                                <li>You earn ₹50 for every successful referral.</li>
                            </ul>
                        </div>
                
                        <div class="referred-users mt-4 p-3 bg-white shadow-sm rounded">
                            <h4>People You Referred</h4>
                            <ul class="list-group" id="referred-list">
                                <% if (referralHistory.length > 0) { %>
                                    <% referralHistory.forEach(user => { %>
                                        <li class="list-group-item d-flex justify-content-between">
                                            <span><%= user.fullName %></span>
                                            <span class="text-success">Earned ₹<%= user.referalAmount %></span>
                                        </li>
                                    <% }) %>
                                <% } else { %>
                                    <li class="list-group-item text-center text-muted">No referrals yet.</li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <section class="footer-section">
            <div class="footer-container">
                <div class="contianer">
                    <div class="row">
                        <div class="col aboutus-container">
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col col-items">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>

                        </div>
                        <div class="col col-items ">
                            <h5>Useful Links</h5>
                            <ul>
                                <li>Privacy Policy</li>
                                <li>Refun & Refund Policy</li>
                                <li>Ship and Delivery policy</li>
                                <li>Terms & Condtitions</li>
                                <li>Disclaimer</li>
                                <li>Carrers</li>
                            </ul>

                        </div>
                    </div>
                </div>
            </div>
            <div class="copy-right-contianer">
                <h5 class="text-center text-white">Copyrights@activeCrop</h5>
            </div>
        </section>
    </mian>

    <script>
        let cropper;
        const alertBox = document.getElementById('alert-box')
        const alertMessage = document.getElementById('alert')
        const imageEditIcon = document.getElementById('edit-icon')

        const progileImage = document.getElementById('profileImg')

        const editButton = document.getElementById('edit-button')
        const editButtonContainer = document.getElementById('edit-contianer')
        const cancelButton = document.getElementById('cancel-button')
        const saveButton = document.getElementById('save-button')
        imageEditIcon.style.display = 'none'
        cancelButton.style.display = 'none'
        saveButton.style.display = 'none'

        const firstNameLabel = document.getElementById('first-name')
        const lastNameLabel = document.getElementById('last-name')
        const userNameLabel = document.getElementById('user-name')
        const userEmailLabel = document.getElementById('email')
        const userPhoneLabel = document.getElementById('user-phone')

        const firstNameInput = document.getElementById('firstName')
        const lastNameInput = document.getElementById('lastName')
        const userNameInput = document.getElementById('userName')
        const userEmailInput = document.getElementById('useremail')
        const userPhoneInput = document.getElementById('userPhone')
        const userImageInput = document.getElementById('imageUpload')

        const reader = new FileReader();

        userImageInput.addEventListener('change', (event) => {
            const file = event.target.files[0]
            if (file) {
                reader.onload = (e) => {
                    if (e.target.result) {
                        progileImage.src = e.target.result;
                    }
                }
                reader.readAsDataURL(file);
            }
        })

        editButton.addEventListener('click', () => {
            imageEditIcon.style.display = 'flex'
            firstNameLabel.style.display = 'none'
            lastNameLabel.style.display = 'none'
            userNameLabel.style.display = 'none'
            userEmailLabel.style.display = 'none'
            userPhoneLabel.style.display = 'none'

            firstNameInput.style.display = 'block'
            lastNameInput.style.display = 'block'
            userNameInput.style.display = 'block'
            userEmailInput.style.display = 'block'
            userPhoneInput.style.display = 'block'
            editButton.style.display = 'none'
            editButtonContainer.style.display = 'none'
            cancelButton.style.display = 'block'
            saveButton.style.display = 'block'
        })
        cancelButton.addEventListener('click', () => {
            imageEditIcon.style.display = 'none'
            firstNameLabel.style.display = 'block'
            lastNameLabel.style.display = 'block'
            userNameLabel.style.display = 'block'
            userEmailLabel.style.display = 'block'
            userPhoneLabel.style.display = 'block'

            firstNameInput.style.display = 'none'
            lastNameInput.style.display = 'none'
            userNameInput.style.display = 'none'
            userEmailInput.style.display = 'none'
            userPhoneInput.style.display = 'none'

            editButton.style.display = 'block'
            editButtonContainer.style.display = 'flex'
            cancelButton.style.display = 'none'
            saveButton.style.display = 'none'
        })
        saveButton.addEventListener('click', () => {
            const fileInput = document.getElementById('imageUpload');
            const file = fileInput.files[0];

            let formData = new FormData();
            formData.append("firstName", firstNameInput.value);
            formData.append("lastName", lastNameInput.value);
            formData.append("userName", userNameInput.value);
            formData.append("email", userEmailInput.value);
            formData.append("phone", userPhoneInput.value);


            if (file) {
                formData.append("profile_image", file);
            }

            fetch('/user/profile/edit', {
                method: 'PUT',
                body: formData
            })
                .then(response => {
                    if (response.ok) {
                        alertMessage.classList.add('alert-success')
                    } else {
                        alertMessage.classList.add('alert-danger')
                    }
                    return response.json()
                })
                .then(data => {
                    alertMessage.innerText = data.message
                    setTimeout(() => {
                        alertMessage.classList.remove('alert-success')
                        window.location.reload()
                    }, 3000)
                })
                .catch(error => {
                    setTimeout(() => {
                        alertMessage.classList.remove('alert-danger')
                    }, 3000)
                });

            editButton.style.display = 'block';
        });

    </script>


    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Order Success</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="shortcut icon" href="../../../../public/asstes/images/logo.jpg" type="image/x-icon">
    <style>
        :root {
            --primary: #F2F3F4;
            --primaryButton: #52BE80;
            --white: #FDFEFE;
            --label-text: #1E1E2C;
            --plceholderText: #000000;
        }

        body {
            background-color: var(--primary);
        }

        .success-icon {
            color: var(--primaryButton);
            font-size: 3rem;
        }

        .card {
            background-color: var(--white);
        }

        .btn-primary {
            background-color: var(--primaryButton);
            border-color: var(--primaryButton);
        }

        .btn-primary:hover {
            background-color: var(--primaryButton);
            opacity: 0.9;
        }

        .text-label {
            color: var(--label-text);
        }
    </style>
</head>

<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="text-center mb-4">
                    <i class="bi bi-check-circle-fill success-icon"></i>
                    <h1 class="text-label mt-3">Order Successful!</h1>
                    <p class="text-label">Thank you for shopping with us</p>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <small class="text-label">Order Number</small>
                                <p class="fw-bold text-label mb-0">#<%= orderDetails.orderNumber %>
                                </p>
                            </div>
                            <i class="bi bi-box-seam text-success"></i>
                        </div>


                        <hr>
                        <div class="mb-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-geo-alt delivery-icon me-2"></i>
                                <h5 class="text-label mb-0">Delivery Address</h5>
                            </div>
                            <div class="ps-4">
                                <p class="text-label mb-1">
                                    <%= orderDetails.shippingAddress.fullName %>
                                </p>
                                <p class="text-label mb-1">
                                    <%= orderDetails.shippingAddress.address_1 %>
                                </p>
                                <p class="text-label mb-1">
                                    <%= orderDetails.shippingAddress.city %>, <%= orderDetails.shippingAddress.state %>
                                </p>
                                <p class="text-label mb-1">
                                    <%= orderDetails.shippingAddress.postalCode %>
                                </p>
                                <p class="text-label mb-1">
                                    <%= orderDetails.shippingAddress.phone %>
                                </p>
                            </div>
                        </div>
                        <hr>
                        <h5 class="text-label mb-3">Order Summary</h5>
                        <% orderDetails.items.forEach(function(item) { %>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-label">
                                    <span class="fw-medium">
                                        <%= item.quantity %>x
                                    </span>
                                    <%= item.product_name %>

                                </span>

                                <span class="text-label">₹<%= item.priceAtPurchanse.toFixed(2) %></span>
                            </div>
                            <% }); %>

                                <hr>
                                <div class="d-flex justify-content-between fw-bold">

                                    <span class="text-label">Shipping</span>
                                    <span class="text-label">₹100</span>
                                </div>
                                <div class="d-flex justify-content-between fw-bold">

                                    <span class="text-label">Total</span>
                                    <span class="text-label">₹<%= (orderDetails.totalAmount).toFixed(2) %></span>
                                </div>
                    </div>
                </div>

                <div class="d-grid gap-3 d-sm-flex justify-content-sm-between">
                    <!-- <button class="btn btn-primary flex-grow-1" onclick="window.print()">
                        <i class="bi bi-printer me-2"></i>Print Receipt
                    </button> -->
                    <a href="/" class="btn btn-outline-secondary flex-grow-1">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        setTimeout(() => {
            window.location.href = '/'
        }, 1000000)
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
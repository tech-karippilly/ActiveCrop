<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Order Details Page</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link rel="stylesheet" href="../../../public/styles/profile.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

</head>

<body>
    <mian>
        <div class="alert-box" id="alert-box">
            <div class="alert " id="alert">

            </div>
        </div>

        <section class="header-section">
            <div class="container-fluid d-flex justify-content-end">
                <div class="row">
                    <div class="col d-flex align-items-center">
                        <i class="fa fa-whatsapp  icon"></i>
                        <span class="text-lowercase  ">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-headset  icon"></i>
                        <span class="text-lowercase">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-comment-alt icon"></i>
                        <span class="text-capitalize">Chat</span>
                    </div>
                    <div class="col profile-container">
                        <!-- <span class="text-capitalize" style="cursor: pointer;"
                            onclick="window.location.href='/auth/login'">Login</span> -->
                        <div class="btn-group">
                            <button type="button" class="btn  dropdown-toggle" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                <%= currentUser.firstName %>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-regular fa-user"></i>
                                            </div>
                                            <div class="col">
                                                Profile
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-solid fa-gear"></i>
                                            </div>
                                            <div class="col">
                                                Settings
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                            </div>
                                            <div class="col">
                                                Logout
                                            </div>
                                        </div>

                        </div>

                        </a></li>
                        </ul>
                    </div>
                </div>
            </div>
            </div>
        </section>

        <section class="logo-section">
            <div class="container-fluid d-flex justify-content-end-start w-100 h-100">
                <div class="row w-25 h-100 ">
                    <div class="col h-100">
                        <img src="../../../../public/asstes/images/logo.jpg" class="logo-image" />
                    </div>
                    <div class="col h-100 logo-text-container">
                        <h5>ACTIVE CROP</h5>
                    </div>
                </div>
            </div>
        </section>

        <section class="container mt-5">
            <div class="row gap-2">

                <div class="col-3 side-menu-section">
                    <div class="header">
                        <h1>Profile</h1>
                    </div>
                    <div class="links-container">
                        <ul class="list-group list-group-flush">
                            <button type="button" class="list-group-item list-group-item-action " aria-current="true"
                                onclick='window.location.href="/user/profile"'>
                                User Details
                            </button>
                            <button type="button" class="list-group-item list-group-item-action"
                                onclick='window.location.href="/user/profile/address"'>
                                Address Management
                            </button>
                            <button type="button" class="list-group-item list-group-item-action active"
                                onclick="window.location.href='/user/profile/order'">
                                Orders
                            </button>
                            <button type="button" class="list-group-item list-group-item-action"
                                onclick="window.location.href='/user/profile/wallet'">
                                Wallets
                            </button>
                            <button type="button" class="list-group-item list-group-item-action "
                                onclick="window.location.href='/user/profile/user-referal'">
                                Referal
                            </button>
                            <button type="button" class="list-group-item list-group-item-action"
                                onclick="window.location.href='/user/profile/password'">
                                Password
                            </button>
                            <button type="button" class="list-group-item list-group-item-action"
                                onclick="window.location.href='/auth/logout'">
                                Logout
                            </button>
                        </ul>
                    </div>
                </div>

                <div class="col-8 content-section">
                    <div id="orderDetailsContainer" class="container mt-5">
                        <!-- Order Information Section -->
                        <div class="row">
                            <div class="col-md-8">
                                <h3>Order Details - <span id="orderId" style="font-size: 0.85em;">
                                        <%= orders.orderNumber %>
                                    </span></h3>
                                <p><strong>Total Price:</strong> ₹<span id="orderTotalPrice">
                                        <%= orders.totalAmount.toFixed(2) %>
                                    </span></p>
                                <p><strong>Status:</strong> <span id="orderStatus"
                                        class="<%= orders.deliveryStatus === 'Pending' ? 'text-warning' : (orders.deliveryStatus === 'Delivered' ? 'text-success' : 'text-danger') %>">
                                        <%= orders.deliveryStatus %>
                                    </span></p>

                                <!-- Product Details Section -->
                                <h4>Product Details:</h4>
                                <ul id="productList" class="list-group">
                                    <% orders.items.forEach(item=> { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <img src="/<%= item.product_image %>" alt="<%= item.product_name %>"
                                                width="50" height="50" class="me-3">
                                            <span>
                                                <%= item.product_name %> - ₹<%= item.priceAtPurchanse %> x <%=
                                                            item.quantity %>
                                            </span>
                                        </li>
                                        <% }); %>
                                </ul>
                            </div>

                            <!-- Address Card Section -->
                            <div class="col-md-4">
                                <h4>Shipping Address:</h4>
                                <div class="card">
                                    <div class="card-body">
                                        <p id="shippingName">
                                            <%= orders.shippingAddress.fullName %>
                                        </p>
                                        <p id="shippingAddress">
                                            <%= orders.shippingAddress.address_1 %>, <%=
                                                    orders.shippingAddress.address_2 %>, <%= orders.shippingAddress.city
                                                        %>, <%= orders.shippingAddress.state %>, <%=
                                                                orders.shippingAddress.country %> - <%=
                                                                    orders.shippingAddress.postalCode %>
                                        </p>
                                        <p id="shippingPhone">+91 <%= orders.shippingAddress.phone %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-3">
                            <% if (orders.deliveryStatus==='Pending' ) { %>
                                <button class="btn btn-danger" onclick="cancelOrder('<%= orders._id %>')">Cancel
                                    Order</button>
                                <% } %>

                                    <% if (orders.paymentStatus==='Failed' ) { %>
                                        <button class="btn btn-warning"
                                            onclick="retryPayment('<%= orders._id %>')">Retry Payment</button>
                                        <% } %>

                                            <% if (orders.deliveryStatus==='Delivered' ) { %>
                                                <button class="btn btn-primary"
                                                    onclick="showReturnForm('<%= orders._id %>')">Return Order</button>
                                                <div id="returnForm_<%= orders._id %>" class="mt-2"
                                                    style="display: none;">
                                                    <input type="text" id="returnReason_<%= orders._id %>"
                                                        class="form-control" placeholder="Enter return reason">
                                                    <small class="text-danger" id="error_<%= orders._id %>"
                                                        style="display: none;">Reason is required</small>
                                                    <button class="btn btn-success mt-2"
                                                        onclick="submitReturn('<%= orders._id %>')">Submit</button>
                                                </div>
                                                <% } %>
                        </div>
                    </div>

                    
                    <div id="orderTrackingTimeline" class="container mt-5">
                        <h3>
                            <%= orders.orderRetrun !=='Pending' ? 'Return Order Tracking' : 'Order Tracking' %>
                        </h3>
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <% if (orders.orderRetrun !=='Pending' ){ %>
                                        <div class="timeline-step text-center">
                                            <div class="step-circle bg-warning text-white">
                                                <i class="fa fa-reply"></i>
                                            </div>
                                            <div
                                                class="step-label <%= (orders.returnStatus === 'Return Requested' || orders.returnStatus === 'Return Approved' || orders.returnStatus === 'Pickup Scheduled' || orders.returnStatus === 'Return Shipped' || orders.returnStatus === 'Return Completed') ? 'fw-bold fs-5' : '' %>">
                                                Return Requested
                                            </div>
                                        </div>
                                        <div class="timeline-step text-center">
                                            <div class="step-circle bg-secondary text-white">
                                                <i class="fa fa-check-circle"></i>
                                            </div>
                                            <div
                                                class="step-label <%= (orders.returnStatus === 'Return Approved' || orders.returnStatus === 'Pickup Scheduled' || orders.returnStatus === 'Return Shipped' || orders.returnStatus === 'Return Completed') ? 'fw-bold fs-5' : '' %>">
                                                Return Approved
                                            </div>
                                        </div>
                                        <div class="timeline-step text-center">
                                            <div class="step-circle bg-info text-white">
                                                <i class="fa fa-calendar-check"></i>
                                            </div>
                                            <div
                                                class="step-label <%= (orders.returnStatus === 'Pickup Scheduled' || orders.returnStatus === 'Return Shipped' || orders.returnStatus === 'Return Completed') ? 'fw-bold fs-5' : '' %>">
                                                Pickup Scheduled
                                            </div>
                                        </div>
                                        <div class="timeline-step text-center">
                                            <div class="step-circle bg-primary text-white">
                                                <i class="fa fa-truck"></i>
                                            </div>
                                            <div
                                                class="step-label <%= (orders.returnStatus === 'Return Shipped' || orders.returnStatus === 'Return Completed') ? 'fw-bold fs-5' : '' %>">
                                                Return Shipped
                                            </div>
                                        </div>
                                        <div class="timeline-step text-center">
                                            <div class="step-circle bg-success text-white">
                                                <i class="fa fa-check"></i>
                                            </div>
                                            <div
                                                class="step-label <%= (orders.returnStatus === 'Return Completed') ? 'fw-bold fs-5' : '' %>">
                                                Return Completed
                                            </div>
                                        </div>

                                </div>

                                <%}else{ %>
                                    <div class="timeline-step text-center">
                                        <div class="step-circle bg-warning text-white">
                                            <i class="fa fa-clock"></i>
                                        </div>
                                        <div
                                            class="step-label <%= (orders.deliveryStatus === 'Pending' || orders.deliveryStatus === 'Packaging' || orders.deliveryStatus === 'Shipped' || orders.deliveryStatus === 'Out for Delivery' || orders.deliveryStatus === 'Delivered') ? 'fw-bold fs-5' : '' %>">
                                            Order Placed
                                        </div>
                                    </div>
                                    <div class="timeline-step text-center">
                                        <div class="step-circle bg-secondary text-white">
                                            <i class="fa fa-box"></i>
                                        </div>
                                        <div
                                            class="step-label <%= (orders.deliveryStatus === 'Packaging' || orders.deliveryStatus === 'Shipped' || orders.deliveryStatus === 'Out for Delivery' || orders.deliveryStatus === 'Delivered') ? 'fw-bold fs-5' : '' %>">
                                            Packaging
                                        </div>
                                    </div>
                                    <div class="timeline-step text-center">
                                        <div class="step-circle bg-info text-white">
                                            <i class="fa fa-truck"></i>
                                        </div>
                                        <div
                                            class="step-label <%= (orders.deliveryStatus === 'Shipped' || orders.deliveryStatus === 'Out for Delivery' || orders.deliveryStatus === 'Delivered') ? 'fw-bold fs-5' : '' %>">
                                            Shipped
                                        </div>
                                    </div>
                                    <div class="timeline-step text-center">
                                        <div class="step-circle bg-primary text-white">
                                            <i class="fa fa-location-arrow"></i>
                                        </div>
                                        <div
                                            class="step-label <%= (orders.deliveryStatus === 'Out for Delivery' || orders.deliveryStatus === 'Delivered') ? 'fw-bold fs-5' : '' %>">
                                            Out for Delivery
                                        </div>
                                    </div>
                                    <div class="timeline-step text-center">
                                        <div class="step-circle bg-success text-white">
                                            <i class="fa fa-check"></i>
                                        </div>
                                        <div
                                            class="step-label <%= (orders.deliveryStatus === 'Delivered') ? 'fw-bold fs-5' : '' %>">
                                            Delivered
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </section>

        <section class="footer-section">
            <div class="footer-container">
                <div class="contianer">
                    <div class="row">
                        <div class="col aboutus-container">
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col col-items">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>

                        </div>
                        <div class="col col-items ">
                            <h5>Useful Links</h5>
                            <ul>
                                <li>Privacy Policy</li>
                                <li>Refun & Refund Policy</li>
                                <li>Ship and Delivery policy</li>
                                <li>Terms & Condtitions</li>
                                <li>Disclaimer</li>
                                <li>Carrers</li>
                            </ul>

                        </div>
                    </div>
                </div>
            </div>
            <div class="copy-right-contianer">
                <h5 class="text-center text-white">Copyrights@activeCrop</h5>
            </div>
        </section>
    </mian>

    <script>
        const alertBox = document.getElementById('alert-box')
        const alertMessage = document.getElementById('alert')
        function cancelOrder(orderId) {
            if (confirm('Are you sure you want to cancel this order?')) {
                fetch(`/orders/order-cancel/${orderId}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                })
                    .then(response => response.json())
                    .then(data => {
                        alertMessage.innerText = data.message
                        alertMessage.classList.add(data.alertType)

                        setTimeout(() => {
                            alertMessage.innerText = ''
                            alertMessage.classList.remove(data.alertType)
                            window.location.reload()
                        }, 2000)
                    })
                    .catch(error => {
                        alertMessage.innerText = data.message
                        alertMessage.classList.add(data.alertType)

                        setTimeout(() => {
                            alertMessage.innerText = ''
                            alertMessage.classList.remove(data.alertType)
                        }, 3000)
                    });
            }
        }


        function retryPayment(orderId) {

            fetch(`/orders/order-retry/${orderId}`)
                .then((response) => response.json())
                .then((data) => {
                    console.log("data", data)
                    if (data.optionsRazorPay) {
                        initializePayment(data.optionsRazorPay)
                    }
                }).catch(error => {
                    console.error(error.message)
                })
        }

        function initializePayment(optionsRazorPay) {
            const razorPayOptions = {
                key: optionsRazorPay.key,
                amount: optionsRazorPay.amount,
                currency: optionsRazorPay.currency,
                description: optionsRazorPay.description,
                order_id: optionsRazorPay.order_id,
                prefill: {
                    name: optionsRazorPay.user.name,
                    email: optionsRazorPay.user.email,
                    contact: optionsRazorPay.user.contact
                },
                handler: function (response) {
                    fetch("http://localhost:3000/orders/payment/verify", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            razorpay_order_id: response.razorpay_order_id,
                            razorpay_payment_id: response.razorpay_payment_id,
                            razorpay_signature: response.razorpay_signature
                        })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.redirect) {
                                window.location.href = data.redirect;
                            } else {
                                alert("Payment verification failed");
                            }
                        })
                        .catch(error => {
                            console.error("Error:", error);
                            alert("Error verifying payment");
                        });
                },
                retry: false,
                modal: {
                    confirm_close: true,
                    ondismiss: function (event) {
                        verifyPayment(razorPayOptions.order_id)
                    }
                }
            };
            try {
                var rzp = new Razorpay(razorPayOptions);
                rzp.open();
            } catch (error) {
            }
        }
        function verifyPayment(order_id) {
            fetch("http://localhost:3000/orders/payment/verify", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    order_id
                })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.redirect) {
                        window.location.href = data.redirect;
                    } else {
                        alert("Payment verification failed");
                    }
                })
                .catch(error => {
                    console.error("Error:", error);
                    alert("Error verifying payment");
                });
        }

        function showReturnForm(orderId) {
            document.getElementById(`returnForm_${orderId}`).style.display = 'block';
        }

        function submitReturn(orderId) {
            const reasonInput = document.getElementById(`returnReason_${orderId}`);
            const errorMsg = document.getElementById(`error_${orderId}`);
            const reason = reasonInput.value.trim();

            if (!reason) {
                errorMsg.style.display = 'block';
                return;
            }

            errorMsg.style.display = 'none';

            fetch('/orders/order-return', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId, reason })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.order) {
                        alert("Return request submitted successfully!");
                        document.getElementById(`returnForm_${orderId}`).style.display = 'none';
                        window.location.reload()
                    } else {
                        alert("Failed to submit return request. Try again!");
                    }
                })
                .catch(error => console.error("Error:", error));
        }

    </script>


    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
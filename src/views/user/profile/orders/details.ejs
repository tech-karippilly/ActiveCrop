    <script>
        const alertBox = document.getElementById('alert-box')

        const orderDetails = {
            id: 'ORD001',
            totalPrice: 150.00,
            status: 'Pending',
            products: [
                { name: 'Product A', quantity: 2 },
                { name: 'Product B', quantity: 1 }
            ],
            shipping: {
                name: 'John Doe',
                address: '123 Main St, Cityville, ST 12345',
                phone: '+1 234-567-890'
            }
        };

        function loadOrderDetails() {
            // Update order information
            document.getElementById('orderId').textContent = orderDetails.id;
            document.getElementById('orderTotalPrice').textContent = orderDetails.totalPrice.toFixed(2);
            document.getElementById('orderStatus').textContent = orderDetails.status;

            // Update product list
            const productList = document.getElementById('productList');
            productList.innerHTML = ''; // Clear existing list
            orderDetails.products.forEach(product => {
                const productItem = `
                <li class="list-group-item">
                    <strong>${product.name}</strong> - Quantity: ${product.quantity}
                </li>
            `;
                productList.insertAdjacentHTML('beforeend', productItem);
            });

            // Update shipping address
            document.getElementById('shippingName').textContent = orderDetails.shipping.name;
            document.getElementById('shippingAddress').textContent = orderDetails.shipping.address;
            document.getElementById('shippingPhone').textContent = orderDetails.shipping.phone;
        }


        document.getElementById('cancelOrderButton').addEventListener('click', function () {
            alert('Order canceled');
        });

        document.getElementById('trackOrderButton').addEventListener('click', function () {
            alert('Tracking order...');
        });

        const currentStatus = "Shipped";  // This can be "Order Placed", "Packaging", "Shipped", etc.

function updateOrderTracking(status) {
    // Get all the timeline steps by ID
    const steps = ['orderPlaced', 'packaging', 'shipped', 'outForDelivery', 'delivered'];

    steps.forEach(step => {
        const stepElement = document.getElementById(step);
        const stepCircle = stepElement.querySelector('.step-circle');
        const stepLabel = stepElement.querySelector('.step-label');

        // Reset all steps to secondary color
        stepCircle.classList.remove('bg-success', 'bg-warning', 'bg-info', 'bg-primary');
        stepCircle.classList.add('bg-secondary');  // default to secondary
        stepLabel.classList.remove('text-success', 'text-warning', 'text-info', 'text-primary');
        stepLabel.classList.add('text-secondary');  // default to secondary text color
    });

    // Update the step based on current status
    switch (status) {
        case 'Order Placed':
            document.getElementById('orderPlaced').querySelector('.step-circle').classList.add('bg-warning');
            document.getElementById('orderPlaced').querySelector('.step-label').classList.add('text-warning');
            break;
        case 'Packaging':
            document.getElementById('packaging').querySelector('.step-circle').classList.add('bg-secondary');
            document.getElementById('packaging').querySelector('.step-label').classList.add('text-secondary');
            break;
        case 'Shipped':
            document.getElementById('shipped').querySelector('.step-circle').classList.add('bg-success');
            document.getElementById('shipped').querySelector('.step-label').classList.add('text-success');
            break;
        case 'Out for Delivery':
            document.getElementById('outForDelivery').querySelector('.step-circle').classList.add('bg-primary');
            document.getElementById('outForDelivery').querySelector('.step-label').classList.add('text-primary');
            break;
        case 'Delivered':
            document.getElementById('delivered').querySelector('.step-circle').classList.add('bg-success');
            document.getElementById('delivered').querySelector('.step-label').classList.add('text-success');
            break;
        default:
            break;
    }
}

// Call the function to update the tracking status
updateOrderTracking(currentStatus);

        // Load the order details when the page loads
        window.onload = loadOrderDetails;

    </script>



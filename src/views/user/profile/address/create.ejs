    <script>
        const alertBox = document.getElementById('alert-box')

        const addressOne = document.getElementById('address1').value.trim()
        const addressTwo = document.getElementById('address2').value.trim()
        const state = document.getElementById('state').value.trim()
        const district = document.getElementById('district').value.trim()
        const city = document.getElementById('city').value.trim()
        const pincode = document.getElementById('pincode').value.trim()
        const phoneNumber = document.getElementById('phone').value.trim()
        const landMark = document.getElementById('land-mark').value.trim()
        const nickName = document.getElementById('nick-name').value.trim()

        const addressRules = /^[A-Za-z0-9\s:,\-\/]+$/;
        const pinCodeRule = /^\d{6}$/
        const phoneRule = /^\d{10}$/
        const normalRule = /^[A-Za-z\s.'-]+$/;


        function validateForm() {
            let isValid = true;

            const addressOne = document.getElementById('address1').value.trim()
            const addressTwo = document.getElementById('address2').value.trim()
            const state = document.getElementById('state').value.trim()
            const district = document.getElementById('district').value.trim()
            const city = document.getElementById('city').value.trim()
            const pincode = document.getElementById('pincode').value.trim()
            const phoneNumber = document.getElementById('phone').value.trim()
            const landMark = document.getElementById('land-mark').value.trim()
            const nickName = document.getElementById('nick-name').value.trim()
            clearErrors();

            if (!addressRules.test(addressOne)) {

                setError('address1', 'Address 1 is required.');
                isValid = false;
            }
            if (!addressRules.test(addressTwo)) {
                setError('address2', 'Address 2 is required.');
                isValid = false;
            }
            if (!normalRule.test(state)) {
                setError('state', 'State is required.');
                isValid = false;
            }
            if (!normalRule.test(district)) {
                setError('district', 'District is required.');
                isValid = false;
            }
            if (!normalRule.test(city)) {
                setError('city', 'City is required.');
                isValid = false;
            }
            if (!pinCodeRule.test(pincode)) {
                setError('pincode', 'PinCode is required. Must have 6 digits');
                isValid = false;
            }
            if (!phoneRule.test(phoneNumber)) {
                setError('phone', 'Phone is required. Must have 10 digits');
                isValid = false;
            }
            if (!normalRule.test(nickName)) {
                setError('nick-name', 'NickName required to add address');
                isValid = false;
            }
            if (!normalRule.test(landMark)) {
                setError('land-mark', 'Land mark required to add address');
                isValid = false;
            }


            return isValid;
        }
        function clearErrors() {
            const errorElements = document.querySelectorAll('.text-danger');
            errorElements.forEach(element => {
                element.textContent = '';
            });
        }
        function setError(field, message) {
            document.getElementById(`error-${field}`).textContent = message;
        }
        function cancel() {
            // Here you can reset the form or do something else when the cancel button is clicked
            if (confirm('Are you sure you want to cancel?')) {
                // Reset form fields
                document.getElementById('editAddressForm').reset();

                // Clear error messages
                clearErrors();
            }
        }

        document.getElementById('editAddressForm').addEventListener('submit', function (event) {
            event.preventDefault();
            clearErrors();
            const isFormValid = validateForm();
            console.log('working', isFormValid)
            if (isFormValid) {
                if (confirm('Form Submitted')) {
                    
                    clearErrors();
                }
            }
        });
    </script>



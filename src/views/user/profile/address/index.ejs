<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Address Page</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link rel="stylesheet" href="../../../public/styles/profile.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

</head>

<body>
    <mian>
        <div class="alert-box" id="alert-box">
            <div class="alert " id="alert-message">

            </div>
        </div>
        <section class="header-section">
            <div class="container-fluid d-flex justify-content-end">
                <div class="row">
                    <div class="col d-flex align-items-center">
                        <i class="fa fa-whatsapp  icon"></i>
                        <span class="text-lowercase  ">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-headset  icon"></i>
                        <span class="text-lowercase">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-comment-alt icon"></i>
                        <span class="text-capitalize">Chat</span>
                    </div>
                    <div class="col profile-container">
                        <!-- <span class="text-capitalize" style="cursor: pointer;"
                            onclick="window.location.href='/auth/login'">Login</span> -->
                        <div class="btn-group">
                            <button type="button" class="btn  dropdown-toggle" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                VISHNU
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-regular fa-user"></i>
                                            </div>
                                            <div class="col">
                                                Profile
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-solid fa-gear"></i>
                                            </div>
                                            <div class="col">
                                                Settings
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="#">
                                        <div class="row">
                                            <div class="col">
                                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                            </div>
                                            <div class="col">
                                                Logout
                                            </div>
                                        </div>

                        </div>

                        </a></li>
                        </ul>
                    </div>
                </div>
            </div>
            </div>
        </section>

        <section class="logo-section">
            <div class="container-fluid d-flex justify-content-end-start w-100 h-100">
                <div class="row w-25 h-100 ">
                    <div class="col h-100">
                        <img src="../../public/asstes/images/logo.jpg" class="logo-image" />
                    </div>
                    <div class="col h-100 logo-text-container">
                        <a href="/"  class="logo-text-container" style="text-decoration: none;">
                            <h5>ACTIVE CROP</h5>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="container mt-5">
            <div class="row gap-2">
                <div class="col-3 side-menu-section">
                    <div class="header">
                        <h1>Profile</h1>
                    </div>
                    <div class="links-container">
                        <ul class="list-group list-group-flush">
                            <button type="button" onclick='window.location.href="/user/profile"'
                                class="list-group-item list-group-item-action " aria-current="true">
                                User Details
                            </button>
                            <button type="button" onclick='window.location.href="/user/profile/address"'
                                class="list-group-item list-group-item-action active">
                                Address Management
                            </button>
                            <button type="button" class="list-group-item list-group-item-action" onclick="window.location.href='/user/profile/order'">
                                Orders
                            </button>
                            <button type="button" class="list-group-item list-group-item-action" onclick="window.location.href='/user/profile/password'">
                                Password
                            </button>
                            <button type="button" class="list-group-item list-group-item-action">
                                Logout
                            </button>
                        </ul>
                    </div>
                </div>
                <div class="col-8 content-section">
                    <div class="text-end">
                        <button class="btn btn-success"
                            onclick="window.location.href='/user/profile/address/create'">Add Address</button>
                    </div>
                    <% if(addressList.length>0){%>
                        <ul class="list-group border-0">
                            <% addressList.forEach((address,index)=>{ %>
                                <li class="list-group-item border-0 border-bottom">
                                    <input class="form-check-input" type="radio" name="flexRadioDefault"
                                        id="flexRadioDefault1" <%=address.is_default ? 'checked' : '' %>
                                    onclick="setDefaultAddress('<%= address._id %>')">
                                        <label class="form-check-label  w-100 p-1" for="firstCheckbox">
                                            <div>
                                                <p class="text-capitalize ">
                                                    <%= address.nickname %>
                                                </p>
                                            </div>
                                            <div>
                                                <label>Address 1</label>
                                                <p>
                                                    <%= address.address_line_1 %>
                                                </p>
                                            </div>
                                            <div>
                                                <label>Address 2</label>
                                                <p>
                                                    <%= address.address_line_2 %>
                                                </p>
                                            </div>
                                            <div class="row ">
                                                <div class="col">
                                                    <label>State</label>
                                                    <p>
                                                        <%= address.state %>
                                                    </p>
                                                </div>
                                                <div class="col">
                                                    <label>District</label>
                                                    <p>
                                                        <%= address.district %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="row ">
                                                <div class="col">
                                                    <label>City</label>
                                                    <p>
                                                        <%= address.city %>
                                                    </p>
                                                </div>
                                                <div class="col">
                                                    <label>PinCode</label>
                                                    <p>
                                                        <%= address.pincode %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div>
                                                <label>Phone</label>
                                                <p>
                                                    <%= address.phone %>
                                                </p>
                                            </div>
                                        </label>
                                        <div class="d-flex ">
                                            <button class="btn btn-warning" onclick="editAddress('<%= address._id %>')">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button class="btn btn-danger ms-2"
                                                onclick="deleteAddress('<%= address._id %>')">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                </li>
                                <% })%>
                        </ul>
                        <%}else{%>
                            <div class="container mt-5">
                                <div class="alert alert-warning text-center" role="alert">
                                    No address has been added yet. Please add one.
                                </div>
                            </div>
                            <%}%>

                </div>

            </div>
        </section>

        <section class="footer-section">
            <div class="footer-container">
                <div class="contianer">
                    <div class="row">
                        <div class="col aboutus-container">
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col col-items">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>

                        </div>
                        <div class="col col-items ">
                            <h5>Useful Links</h5>
                            <ul>
                                <li>Privacy Policy</li>
                                <li>Refun & Refund Policy</li>
                                <li>Ship and Delivery policy</li>
                                <li>Terms & Condtitions</li>
                                <li>Disclaimer</li>
                                <li>Carrers</li>
                            </ul>

                        </div>
                    </div>
                </div>
            </div>
            <div class="copy-right-contianer">
                <h5 class="text-center text-white">Copyrights@activeCrop</h5>
            </div>
        </section>
    </mian>

    <script>
        const alertBox = document.getElementById('alert-box')
        const alertMessage = document.getElementById('alert-message')

        function setDefaultAddress(addressId) {
            fetch(`/user/profile/address/${addressId}`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json'
                },
            })
                .then(response => response.json())
                .then(data => {
                    alertMessage.classList.add(data.alertType)
                    alertMessage.innerHTML = data.message

                    setTimeout(() => {
                        alertMessage.classList.remove(data.alertType)
                        alertMessage.innerHTML = ''
                        window.location.reload()
                    }, 3000)
                })
                .catch(error => {
                    alertMessage.classList.add(data.alertType)
                    alertMessage.innerHTML = data.message

                    setTimeout(() => {
                        alertMessage.classList.remove(data.alertType)
                        alertMessage.innerHTML = ''

                    }, 3000)
                });
        }

        function deleteAddress(addressId) {
            if (confirm('Are you sure you want to delete this address?')) {
                fetch(`/user/profile/address/${addressId}`, {
                    method: 'DELETE'
                })
                    .then(response => response.json())
                    .then(data => {
                        alertMessage.classList.add(data.alertType)
                        alertMessage.innerHTML = data.message

                        setTimeout(() => {
                            alertMessage.classList.remove(data.alertType)
                            alertMessage.innerHTML = ''
                            window.location.reload()
                        }, 3000)
                    })
                    .catch(error => {
                        alertMessage.classList.add(data.alertType)
                        alertMessage.innerHTML = data.message

                        setTimeout(() => {
                            alertMessage.classList.remove(data.alertType)
                            alertMessage.innerHTML = ''

                        }, 3000)
                    });
            }
        }
        function editAddress(addressId) {
            window.location.href = `/user/profile/address/${addressId}`;
        }
    </script>


    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
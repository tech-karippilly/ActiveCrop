<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details | Active Crop </title>
    <link rel="stylesheet" href="../../../public/styles/homePage.css">
    <link rel="stylesheet" href="../../../public/styles/productStyles.css">
    <link rel="stylesheet" href="../../../public/styles/productDetails.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>

    </style>
</head>

<body>

    <main class="w-100">
        <div class="alert-box" id="alert-box">
            <div class="alert " id="alert">

            </div>
        </div>

        <section class="header-section">
            <div class="container-fluid d-flex justify-content-end">
                <div class="row">
                    <div class="col d-flex align-items-center">
                        <i class="fa fa-whatsapp  icon"></i>
                        <span class="text-lowercase  ">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-headset  icon"></i>
                        <span class="text-lowercase">8078599537</span>
                    </div>
                    <div class="col d-flex align-items-center">
                        <i class="fas fa-comment-alt icon"></i>
                        <span class="text-capitalize">Chat</span>
                    </div>
                    <div class="col profile-container">
                        <% if(isLogin) { %>
                            <div class="btn-group">
                                <button type="button" class="btn  dropdown-toggle" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    <%= currentUser.firstName %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="/user/profile">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-regular fa-user"></i>
                                                </div>
                                                <div class="col">
                                                    Profile
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-solid fa-gear"></i>
                                                </div>
                                                <div class="col">
                                                    Settings
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="row">
                                                <div class="col">
                                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                                </div>
                                                <div class="col" onclick="window.location.href='/auth/logout'">
                                                    Logout
                                                </div>
                                            </div>
                                        </a>
                                    </li>

                                </ul>

                            </div>
                            <%}else { %>
                                <span class="text-capitalize" style="cursor: pointer;"
                                    onclick="window.location.href='/auth/login'">Login</span>
                                <%}%>



                    </div>
                </div>
            </div>
            </div>
        </section>

        <section class="logo-section py-2 ">
            <div class="container-fluid d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center logo-text-container">
                    <a href="/" class="d-flex align-items-center text-decoration-none w-100" style="color: #52BE80;">
                        <img src="../../../public/asstes/images/logo.jpg" class="logo-image me-2" style="height: 50px;"
                            alt="Logo" />
                        <h5 class="mb-0 fw-bold text-center">ACTIVE CROP</h5>
                    </a>
                </div>

                <div class="d-flex align-items-center  text-white p-2 rounded w-50 justify-content-between">

                    <form class="d-flex w-75" method="get" action="/products/search/<%= activeCata %>">
                        <input class="form-control me-2" type="search" name="query" placeholder="Search..." aria-label="Search">
                        <button class="btn btn-outline-success" type="submit">Search</button>
                    </form>

                    <div class="position-relative">
                        <i class="fa fa-shopping-cart fa-2x text-secondary" onclick="onCartClick()"></i>
                        <%if(isLogin){ %>
                            <span
                                class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cartLength %>
                                    <span class="visually-hidden">unread messages</span>
                            </span>
                            <% }%>

                    </div>
                </div>
            </div>
        </section>

        <secton class="main-container">
            <div class="catagoery-container">
                <ul class="categoery-list">
                    <% categories.forEach((catagories)=>{ %>
                        <li><a href="/products/<%=catagories._id %>" class="btn text-white btn-hover-underline">
                                <%= catagories.catagoery_name %>
                            </a></li>
                        <% })%>
                </ul>
            </div>

            <div class="mt-5 mb-3" style="height: 10vh;">
                <nav aria-label="breadcrumb" class="ms-5 m-1">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item"><a href="/products/<%= activeCata %>" class="text-decoration-none">
                                <%= activeCataName %>
                            </a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <%= products.product_name %>
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="min-vh-40 " style="max-height: auto;">

                <div class="product-details-container row align-items-center">
                    <!-- Product Image Slider -->
                    <div class="col-md-6">
                        <div id="productCarousel" class="carousel slide shadow-lg rounded" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                <% Object.keys(products.images).forEach(function (key, index) { %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                        <img src="/<%= products.images[key] %>" class="d-block w-100"
                                            alt="Product Image <%= parseInt(key) + 1 %>"
                                            style="height: 400px; object-fit:fill; border-radius: 10px;">
                                    </div>
                                <% }); %>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel"
                                data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel"
                                data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
            
                    <!-- Product Information -->
                    <div class="col-md-6">
                        <h2 class="fw-bold"><%= products.product_name %></h2>
                        <p class="text-muted"><strong>Description:</strong> <%= products.description %></p>
                        <p><strong>Pack Size:</strong> 1 kg</p>
            
                        <!-- Offer Price Handling -->
                        <p class="product-price fw-bold fs-4">
                            <% if (products.offer_price  && products.offer_price > 0) { %>
                                <span class="text-success">₹<%= products.offer_price %></span>
                                <span class="text-muted text-decoration-line-through fs-6 ms-2">₹<%= products.price %></span>
                            <% } else { %>
                                <span class="text-primary">₹<%= products.price %></span>
                            <% } %>
                        </p>
            
                        <!-- Stock Status -->
                        <p class="stock-status <%= products.stock_quantity > 0 ? 'text-success' : 'text-danger' %>">
                            <strong>Stock:</strong> <%= products.stock_quantity > 0 ? 'Available' : 'Out of Stock' %>
                        </p>
            
                        <!-- Add to Cart Button -->
                        <% if (products.stock_quantity > 0) { %>
                            <button class="btn btn-success w-100 py-2 mt-3" onclick="addToCart('<%= products._id %>')">
                                Add to Cart
                            </button>
                        <% } else { %>
                            <button class="btn btn-danger w-100 py-2 mt-3" disabled>Out of Stock</button>
                        <% } %>
                    </div>
                </div>

            </div>

        </secton>

        <section class="footer-section">
            <div class="footer-container">
                <div class="contianer">
                    <div class="row">
                        <div class="col aboutus-container">
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col col-items">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>

                        </div>
                        <div class="col col-items ">
                            <h5>Useful Links</h5>
                            <ul>
                                <li>Privacy Policy</li>
                                <li>Refun & Refund Policy</li>
                                <li>Ship and Delivery policy</li>
                                <li>Terms & Condtitions</li>
                                <li>Disclaimer</li>
                                <li>Carrers</li>
                            </ul>

                        </div>
                    </div>
                </div>
            </div>
            <div class="copy-right-contianer">
                <h5 class="text-center text-white">Copyrights@activeCrop</h5>
            </div>
        </section>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>
    <script>
        // Image zoom functionality
        const alertMessage = document.getElementById('alert')
        document.querySelectorAll('.product-image-container img').forEach(img => {
            img.addEventListener('mousemove', e => {
                const { left, top, width, height } = img.getBoundingClientRect();
                const x = (e.clientX - left) / width * 100;
                const y = (e.clientY - top) / height * 100;
                img.style.transformOrigin = `${x}% ${y}%`;
                img.style.transform = 'scale(1.5)';
            });

            img.addEventListener('mouseleave', () => {
                img.style.transform = 'scale(1)';
            });
        });

        function addToCart(productId) {

            const isLoggedIn = '<%= isLogin %>' === 'true'

            if (isLoggedIn) {
                fetch('/user/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ productId, quantity: 1 })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.cart) {
                            alertMessage.innerHTML = 'Added to Cart'
                            alertMessage.classList.add('alert-success')
                            setTimeout(() => {
                                alertMessage.innerHTML = ''
                                alertMessage.classList.remove('alert-success')
                                window.location.reload()
                            }, 5000)
                        }

                    })
                    .catch(error => {
                    })
            } else {
                alertMessage.innerHTML = 'Please Login '
                alertMessage.classList.add('alert-warning')
                setTimeout(() => {
                    alertMessage.innerHTML = ''
                    alertMessage.classList.remove('alert-warning')
                }, 5000)
            }
        }
    </script>
</body>

</html>
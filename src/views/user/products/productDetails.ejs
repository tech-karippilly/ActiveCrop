<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Cropt | Products</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link rel="stylesheet" href="../../../public/styles/productStyles.css">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

</head>

<body>
    <section class="bg-light d-flex justify-content-end align-items-center" style="height: 2rem;">
        <div class="d-flex gap-3 me-3">
            <div class="d-flex align-items-center">
                <i class="fa fa-whatsapp me-1"></i>
                <span class="text-lowercase">8078599537</span>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-headset me-1"></i>
                <span class="text-lowercase">8078599537</span>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-comment-alt me-1"></i>
                <span class="text-capitalize">Chat</span>
            </div>
            <div class="d-flex align-items-center">
                <% if(isLogin) { %>
                    <span style="cursor: pointer;" onclick="window.location.href='/auth/logout'">
                        <%= currentUser.firstName %>
                    </span>
                    <%}else { %>
                        <span class="text-capitalize" style="cursor: pointer;"
                            onclick="window.location.href='/auth/login'">Login</span>
                        <%}%>
            </div>
        </div>
    </section>

    <section class="header-section d-flex justify-content-center">
        <div class="row   w-100 h-100  d-flex  justify-content-between">
            <div class="col-4 d-flex justify-content-center align-items-center h-100 ">
                <a href="/">
                    <div class="image-container">
                        <img src="../../../public/asstes/images/logo.jpg" class="image">
                    </div>
                </a>
                <div class="logo-text-container">
                    <h1>Active crop</h1>
                </div>
            </div>
            <div class="col-5 p-3 d-flex align-items-center justify-content-between">

                <form class="d-flex w-75">
                    <input class="form-control me-2" type="search" placeholder="Search products..." aria-label="Search">
                    <button class="btn btn-light" type="submit">Search</button>
                </form>

                <div class="position-relative">
                    <button class="btn btn-light position-relative">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            3
                        </span>
                    </button>
                </div>

            </div>
        </div>
    </section>

    <section class="categoery-container">
        <ul class="categoery-list">
            <% catagories.forEach((catagories)=>{ %>
                <li><a href="/products/<%=catagories._id %>"
                        class="btn  btn-hover-underline <%= catagories._id.toString() === activeCata.toString() ?'active-category'  : 'normal-catagoery' %>">
                        <%= catagories.catagoery_name %>
                    </a></li>
                <% })%>
        </ul>
    </section>

    <nav aria-label="breadcrumb ms-5 m-1">
        <ul class="breadcrumb">
            <li><a href="/">Home</a></li>
            <li><a href="/products/<%= activeCata %>">
                    <%= activeCataName %>
                </a></li>
            <li>
                <%= products.product_name %>
            </li>
        </ul>
    </nav>

    <div class="condent-section">
        <div class='container w-100 h-100 pt-5'>
            <div class="row  w-100 h-100 ">
                <div class="col-5  overflow-hidden">
                    <div id="carouselExample" class="carousel slide w-100 h-100">
                        <div class="carousel-inner">
                            <% if (products && products.images) { %>
                                <% Object.values(products.images).forEach((image, index)=> { %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                        <div class="zoom-container">
                                            <img src="http://localhost:3000/<%= image %>"
                                                class="d-block w-100 h-100 zoom-image" alt="Product Image"
                                                style=" object-fit: contain;">
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="carousel-item active">
                                                <img src="/images/no-image.jpg" class="d-block w-100"
                                                    alt="No Image Available"
                                                    style="max-height: 300px; object-fit: cover;">
                                            </div>
                                            <% } %>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample"
                            data-bs-slide="prev">
                            <i class="fa-solid fa-chevron-left text-dark fs-1" aria-hidden="true"></i>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next " type="button" data-bs-target="#carouselExample"
                            data-bs-slide="next">

                            <i class="fa-solid fa-chevron-right text-dark fs-1" aria-hidden="true"></i>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>

                </div>

                <div class="col-7 h-100 ">
                    <div class="container col-controller d-flex flex-column justify-content-center align-items-start">
                        <div class="mb-4">
                            <h1>
                                <%= products.product_name %>
                            </h1>
                        </div>

                        <div class="mb-4">
                            <p>
                                <%= products.description %>
                            </p>
                        </div>
                        <div class="mb-4 w-75">
                            <div class="row">
                                <div class="col">
                                    <h4>MRP <i class="fa-solid fa-indian-rupee-sign "></i>
                                        <%= products.price %>
                                    </h4>
                                </div>
                                <div class="col">
                                    <h4>Package: 1 kg</h4>
                                </div>
                            </div>
                        </div>

                        <% if(products.stock_quentity=='0' ) { %>
                            <div class="mb-4">
                                <h4 class="text-danger">Product out of Stock</h4>
                            </div>
                            <% } else { %>
                                <div class="mb-4 row w-75">
                                    <div class=" col">
                                        <button class="btn btn-primary">Add to Cart </button>
                                    </div>
                                    <div class=" col">
                                        <button class="btn btn-primary">Save for later</button>
                                    </div>
                                </div>
                                <% } %>

                    </div>
                </div>
            </div>

            <div>
                <h1>Rating and Reviews</h1>

                <div class="container">
                    <% if(reviews && reviews.length===0){ %>
                        <h5 class="text-secondary">No reviews yet to display</h5>
                        <%}else{ %>

                            <% } %>
                </div>
            </div>

        </div>
    </div>


    <footer class="footet-container">
        <div class="row footer-condent">
            <div class="col aboutus-container">
                <p>
                    Active Crop is an e-commerce platform designed to connect farmers directly with customers, enabling
                    the sale of fresh vegetables and fruits. The core idea is to source produce directly from farmers,
                    ensuring freshness and fair pricing. Customers can browse and purchase products online, while
                    farmers earn 85% of each sale, with 15% retained by the platform as commission (plus delivery
                    charges).
                    The project emphasizes sustainability, farmer empowerment, and customer satisfaction, offering
                    transparent pricing, fast delivery, and eco-friendly practices. With features like user-friendly
                    dashboards for both farmers and customers, secure payment systems, and a reliable delivery network,
                    Active Crop aims to revolutionize the way people access fresh produce while supporting the farming
                    community.
                </p>
            </div>
            <div class="col col-items">
                <h5>Get To Know Us</h5>
                <ul>
                    <li>About Us</li>
                    <li>Our Farmers</li>
                    <li>Gallery</li>
                    <li>Media</li>
                    <li>Blog</li>
                </ul>

            </div>
            <div class="col col-items ">
                <h5>Useful Links</h5>
                <ul>
                    <li>Privacy Policy</li>
                    <li>Refun & Refund Policy</li>
                    <li>Ship and Delivery policy</li>
                    <li>Terms & Condtitions</li>
                    <li>Disclaimer</li>
                    <li>Carrers</li>
                </ul>

            </div>
        </div>
        <div class="row copyright-container">
            <p>copyright@activecrop.com</p>
        </div>
    </footer>

    <script>
        document.querySelectorAll(".zoom-container").forEach((container) => {
            const img = container.querySelector(".zoom-image");

            container.addEventListener("mousemove", (e) => {
                const { left, top, width, height } = container.getBoundingClientRect();
                const x = (e.clientX - left) / width * 100;
                const y = (e.clientY - top) / height * 100;

                img.style.transformOrigin = `${x}% ${y}%`;
                img.style.transform = "scale(2)";
            });

            container.addEventListener("mouseleave", () => {
                img.style.transform = "scale(1)";
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Cropt | Products</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link rel="stylesheet" href="../../../public/styles/productStyles.css">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

</head>

<body>
    <div class="bg-light d-flex justify-content-end align-items-center" style="height: 2rem;">
        <div class="d-flex gap-3 me-3">
            <div class="d-flex align-items-center">
                <i class="fa fa-whatsapp me-1"></i>
                <span class="text-lowercase">8078599537</span>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-headset me-1"></i>
                <span class="text-lowercase">8078599537</span>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-comment-alt me-1"></i>
                <span class="text-capitalize">Chat</span>
            </div>
            <div class="d-flex align-items-center">
                <% if(isLogin) { %>
                    <span style="cursor: pointer;" onclick="window.location.href='/auth/logout'">
                        <%= currentUser.firstName %>
                    </span>
                    <%}else { %>
                        <span class="text-capitalize" style="cursor: pointer;"
                            onclick="window.location.href='/auth/login'">Login</span>
                        <%}%>
            </div>
        </div>
    </div>
    <div class="header-section d-flex justify-content-center">
        <div class="row   w-100 h-100  d-flex  justify-content-between">
            <div class="col-4 d-flex justify-content-center align-items-center h-100 ">
                <a href="/">
                    <div class="image-container">
                        <img src="../../../public/asstes/images/logo.jpg" class="image">
                    </div>
                </a>
                <div class="logo-text-container">
                    <h1>Active crop</h1>
                </div>
            </div>
            <div class="col-5 p-3 d-flex align-items-center justify-content-between">

                <form class="d-flex w-75">
                    <input class="form-control me-2" type="search" placeholder="Search products..." aria-label="Search">
                    <button class="btn btn-light" type="submit">Search</button>
                </form>
                <div class="position-relative">
                    <button class="btn btn-light position-relative">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            3
                        </span>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="categoery-container">
        <ul class="categoery-list">
            <% catagories.forEach((catagories)=>{ %>
                <li><a href="/products/<%=catagories._id %>"
                        class="btn  btn-hover-underline <%= catagories._id.toString() === activeCata.toString() ?'active-category'  : 'normal-catagoery' %>">
                        <%= catagories.catagoery_name %>
                    </a></li>
                <% })%>
        </ul>
    </div>

    <div class="condent-section">
        <div class="container w-100 h-100 pt-5">
            <% if (products.length===0) { %>
                <div>
                    <h1>Don't have products to display</h1>
                </div>
                <% } else { %>
                    <div class="row">
                        <% products.forEach(function(product) { %>
                            <div class="col-md-3 mb-4">
                                <a href="/products/details/<%= product._id %>/<%= activeCata %>"
                                    class="text-decoration-none text-dark">
                                    <div class="card">
                                        <img src="/<%= product.images[0] %>" class="card-img-top"
                                            alt="<%= product.product_name %>"
                                            style="width: 100%; height: 200px; object-fit: contain;">
                                        <div class="card-body">
                                            <h5 class="card-title text-center">
                                                <%= product.product_name %>
                                            </h5>
                                            <div>
                                                <p class="description-line-clamp">
                                                    <%= product.description %>
                                                </p>
                                            </div>
                                            <div class="row">
                                                <div class="col">
                                                    <p class="card-text">Price: $<%= product.price %>
                                                    </p>
                                                </div>
                                                <div class="col">
                                                    <p class="card-text">Kg</p>
                                                </div>
                                            </div>

                                            <div class="w-100 d-flex justify-content-center mt-3">
                                                <button class="btn btn-primary">Add to Cart</button>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </div>
    </div>

    <div class="footet-container">
        <div class="row footer-condent">
            <div class="col aboutus-container">
                <p>
                    Active Crop is an e-commerce platform designed to connect farmers directly with customers, enabling
                    the sale of fresh vegetables and fruits. The core idea is to source produce directly from farmers,
                    ensuring freshness and fair pricing. Customers can browse and purchase products online, while
                    farmers earn 85% of each sale, with 15% retained by the platform as commission (plus delivery
                    charges).
                    The project emphasizes sustainability, farmer empowerment, and customer satisfaction, offering
                    transparent pricing, fast delivery, and eco-friendly practices. With features like user-friendly
                    dashboards for both farmers and customers, secure payment systems, and a reliable delivery network,
                    Active Crop aims to revolutionize the way people access fresh produce while supporting the farming
                    community.
                </p>
            </div>
            <div class="col col-items">
                <h5>Get To Know Us</h5>
                <ul>
                    <li>About Us</li>
                    <li>Our Farmers</li>
                    <li>Gallery</li>
                    <li>Media</li>
                    <li>Blog</li>
                </ul>

            </div>
            <div class="col col-items ">
                <h5>Useful Links</h5>
                <ul>
                    <li>Privacy Policy</li>
                    <li>Refun & Refund Policy</li>
                    <li>Ship and Delivery policy</li>
                    <li>Terms & Condtitions</li>
                    <li>Disclaimer</li>
                    <li>Carrers</li>
                </ul>

            </div>
        </div>
        <div class="row copyright-container">
            <p>copyright@activecrop.com</p>
        </div>
    </div>

    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Dashboard</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/admin/order.css" rel="stylesheet" type="text/css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

</head>

<body>
    <div class="container-fluid row">
        <section class="side-bar col-md-3">
            <div class="side-bar-heading">
                <h1>ADMIN</h1>
            </div>
            <div class="side-bar-menu" id="menuId">
                <div class="link-container"><a href="/admin/dashboard" class="link-text">Dashboard</a></div>
                <div class="link-container"><a href="/admin/catagoery" class="link-text">Category</a></div>
                <div class="link-container"><a href="/admin/products" class="link-text">Products</a></div>
                <div class="link-container"><a href="/admin/customers" class="link-text">Customers</a></div>
                <div class="link-container"><a href="#" class="link-text-active">Orders</a></div>
                <div class="link-container"><a href="#" class="link-text">Coupons</a></div>
                <div class="link-container"><a href="#" class="link-text">Banner</a></div>
                <div class="link-container"><a href="#" class="link-text">Transactions</a></div>
                <div class="link-container"><a onclick="logoutUser()" class="button-link">Logout</a></div>
            </div>
        </section>

        <section class="container-section col-md-9">
            <h2 class="mb-4">Order List</h2>
            <table>
                <thead>
                    <tr>
                        <th>Order Number</th>
                        <th>Items Count</th>
                        <th>Total Price</th>
                        <th>Payment Mode</th>
                        <th>Order Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(order=> { %>
                        <tr>
                            <td>
                                <%= order.orderNumber %>
                            </td>
                            <td>
                                <%= order.items.length %>
                            </td>
                            <td>₹<%= order.totalAmount %>
                            </td>
                            <td>
                                <%= order.paymentMethod.toUpperCase() %>
                            </td>
                            <td>
                                <%= order.deliveryStatus %>
                            </td>
                            <td>
                                <a href="/admin/orders/<%= order._id %>" class="btn btn-primary btn-sm">View</a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="pagination">
                <% if (currentPage> 1) { %>
                    <a href="?page=<%= currentPage - 1 %>">Previous</a>
                    <% } %>

                        <% for (let i=1; i <=totalPages; i++) { %>
                            <a href="?page=<%= i %>" class="<%= currentPage === i ? 'active' : '' %>">
                                <%= i %>
                            </a>
                            <% } %>

                                <% if (currentPage < totalPages) { %>
                                    <a href="?page=<%= currentPage + 1 %>">Next</a>
                                    <% } %>
            </div>
        </section>
    </div>

    <script>
        function logoutUser() {
            fetch('/api/admin/auth/logout', { method: 'GET' })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin';
                    }
                }).catch(error => {
                    console.error("Logout failed", error);
                });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
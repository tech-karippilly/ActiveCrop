<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Dashboard</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="/public/styles/admin/order.css" rel="stylesheet" type="text/css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="contianer-fluid main-contianer">
        <section class="side-bar">
            <div class="side-bar-heading">
                <h1>ADMIN</h1>
            </div>
            <div class="side-bar-menu" id="menuId">
                <div class="link-container">
                    <a href="/admin/dashboard" class="link-text">Dashboard</a>
                </div>
                <div class="link-container">
                    <a href="/admin/catagoery" class="link-text">Categoery</a>
                </div>
                <div class="link-container">
                    <a href="/admin/products" class="link-text">Products</a>
                </div>
                <div class="link-container">
                    <a href="/admin/customers" class="link-text">Customers</a>
                </div>
                <div class="link-container">
                    <a href="/admin/orders" class="link-text-active">Orders</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Coupons</a>
                </div>

                <div class="link-container">
                    <a href="#" class="link-text">Banner</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Transactions</a>
                </div>
                <div class="link-container">
                    <a onclick="logoutUser()" class="button-link">Logout</a>
                </div>
            </div>
        </section>
        <section class="container-section">
            <h2 class="mb-4">Order List</h2>
            <table>
                <thead>
                    <tr>
                        <th>Order Number</th>
                        <th>Items Count</th>
                        <th>Total Price</th>
                        <th>Payment Mode</th>
                        <th>Order Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(order=> { %>
                        <tr>
                            <td>
                                <%= order.orderNumber %>
                            </td>
                            <td>
                                <%= order.items.length %>
                            </td>
                            <td>₹<%= order.totalAmount %>
                            </td>
                            <td>
                                <%= order.paymentMethod.toUpperCase() %>
                            </td>
                            <td>
                                <%= order.deliveryStatus %>
                            </td>
                            <td>
                                <a href="/admin/orders/<%= order._id %>" class="btn  btn-sm">View</a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="pagination">
                <% if (currentPage> 1) { %>
                    <a href="?page=<%= currentPage - 1 %>">Previous</a>
                    <% } %>

                        <% for (let i=1; i <=totalPages; i++) { %>
                            <a href="?page=<%= i %>" class="<%= currentPage === i ? 'active' : '' %>">
                                <%= i %>
                            </a>
                            <% } %>

                                <% if (currentPage < totalPages) { %>
                                    <a href="?page=<%= currentPage + 1 %>">Next</a>
                                    <% } %>
            </div>

        </section>
    </div>


    <script>



        function logoutUser() {
            fetch('/api/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin'
                    }
                }).catch(error => {
                })
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
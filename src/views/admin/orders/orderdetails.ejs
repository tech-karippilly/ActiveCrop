<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Dashboard</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">
    <link href="/public/styles/admin/orderdetails.css" rel="stylesheet" type="text/css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="contianer-fluid main-contianer">
        <section class="side-bar">
            <div class="side-bar-heading">
                <h1>ADMIN</h1>
            </div>
            <div class="side-bar-menu" id="menuId">
                <div class="link-container">
                    <a href="/admin/dashboard" class="link-text">Dashboard</a>
                </div>
                <div class="link-container">
                    <a href="/admin/catagoery" class="link-text">Categoery</a>
                </div>
                <div class="link-container">
                    <a href="/admin/products" class="link-text">Products</a>
                </div>
                <div class="link-container">
                    <a href="/admin/customers" class="link-text">Customers</a>
                </div>
                <div class="link-container">
                    <a href="/admin/orders" class="link-text-active">Orders</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Coupons</a>
                </div>

                <div class="link-container">
                    <a href="#" class="link-text">Banner</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Transactions</a>
                </div>
                <div class="link-container">
                    <a onclick="logoutUser()" class="button-link">Logout</a>
                </div>
            </div>
        </section>
        <section class="container-section">
            <h2>Order Details - <%= order.orderNumber %>
            </h2>
            <div class="mt-1 me-4">
                <h4 class="mt-4">Shipping Address</h4>

                <p><strong>Name:</strong>
                    <%= order.shippingAddress.fullName %>
                </p>
                <p><strong>Address:</strong>
                    <%= order.shippingAddress.street %>, <%= order.shippingAddress.city %>, <%=
                                order.shippingAddress.state %> - <%= order.shippingAddress.postalCode %>
                </p>
                <p><strong>Phone:</strong>
                    <%= order.shippingAddress.phone %>
                </p>
            </div>
            <div>
                <h4 class="mt-4">Items Ordered</h4>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Price (₹)</th>
                            <th>Total (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.items.forEach(item=> { %>
                            <tr>
                                <td>
                                    <%= item.product_name %>
                                </td>
                                <td>
                                    <%= item.quantity %>
                                </td>
                                <td>₹<%= item.priceAtPurchanse %>
                                </td>
                                <td>₹<%= item.priceAtPurchanse * item.quantity %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (order.deliveryStatus==='Retrun Order Processing' ){%>
                <div>
                    <h4 class="mt-4"> Order Return Status</h4>
                    <h4 class="mt-4 
                    <%= order.deliveryStatus === 'Retrun Order Processing' ? 'text-primary' : '' %> 
        <%= order.orderRetrun === 'Pending' ? 'text-warning' : '' %> 
        <%= (order.orderRetrun === 'Processing') ? 'text-info' : '' %> 
        <%= order.orderRetrun === 'Approved' ? 'text-success' : '' %> 
        <%= order.orderRetrun === 'Rejected' ? 'text-danger' : '' %>">
                        <%= order.orderRetrun %>
                    </h4>
                </div>
                <%}else{%>
                    <div>
                        <h4 class="mt-4"> Order Status</h4>
                        <h4 class="mt-4 
        <%= order.deliveryStatus === 'Pending' ? 'text-warning' : '' %> 
        <%= (order.deliveryStatus === 'Packaging' || order.deliveryStatus === 'Shipped') ? 'text-info' : '' %> 
        <%= order.deliveryStatus === 'Delivered' ? 'text-success' : '' %> 
        <%= order.deliveryStatus === 'Returned' ? 'text-success' : '' %> 
        <%= order.deliveryStatus === 'Cancelled' ? 'text-danger' : '' %>">

                            <%= order.deliveryStatus %>
                        </h4>
                    </div>
                    <% }%>

                        <% if (order.orderRetrun==='Processing' ){%>
                            <div>
                                <h4 class="mt-4">Update Return Order Status</h4>

                                <%if(order.orderRetrun !=='Approved' || order.orderRetrun !=='Rejected' ){%>
                                    <form onsubmit="updateRetrunOrderStatus(event, '<%= order._id %>')">
                                        <div class="mb-3">
                                            <select name="status" class="form-select" required>
                                                <option value="Pending" <%=order.orderRetrun==='Pending' ? 'selected'
                                                    : '' %>>Pending</option>
                                                <option value="Processing" <%=order.orderRetrun==='Processing'
                                                    ? 'selected' : '' %>>Processing</option>
                                                <option value="Approved" <%=order.orderRetrun==='Approved' ? 'selected'
                                                    : '' %>>Approved</option>
                                                <option value="Rejected" <%=order.deliveryStatus==='Rejected'
                                                    ? 'selected' : '' %>>Rejected</option>
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-success">Update Retrun Status</button>
                                    </form>
                                    <%}else {%>
                                        <% if (order.orderRetrun==='Approved' ) { %>
                                            <div class="alert alert-success" role="alert">
                                                This order Retrun has been <strong>Approved</strong>.
                                            </div>
                                            <%}else if(order.orderRetrun==='Rejected' ) {%>
                                                <div class="alert alert-danger" role="alert">
                                                    This order Retrun has been <strong>Rejected</strong>.
                                                </div>
                                                <%}%>
                                                    <%}%>

                            </div>
                            <% }else {%>
                                <div>

                                    <% if (order.deliveryStatus !=='Cancelled' && order.deliveryStatus !=='Delivered' &&
                                        order.deliveryStatus !=='Returned' ) { %>
                                        <h4 class="mt-4">Update Order Status</h4>
                                        <form onsubmit="updateOrderStatus(event, '<%= order._id %>')">
                                            <div class="mb-3">
                                                <select name="status" class="form-select" required>
                                                    <option value="Pending" <%=order.deliveryStatus==='Pending'
                                                        ? 'selected' : '' %>>Pending</option>
                                                    <option value="Shipped" <%=order.deliveryStatus==='Shipped'
                                                        ? 'selected' : '' %>>Shipped</option>
                                                    <option value="Delivered" <%=order.deliveryStatus==='Delivered'
                                                        ? 'selected' : '' %>>Delivered</option>
                                                    <option value="Cancelled" <%=order.deliveryStatus==='Cancelled'
                                                        ? 'selected' : '' %>>Cancelled</option>
                                                </select>
                                            </div>
                                            <button type="submit" class="btn btn-success">Update Status</button>
                                        </form>
                                        <% } else { %>
                                            <% if (order.deliveryStatus==='Cancelled' ) { %>
                                                <div class="alert alert-danger" role="alert">
                                                    This order has been <strong>Cancelled</strong>.
                                                </div>
                                                <% } else if (order.deliveryStatus==='Delivered' ) { %>
                                                    <div class="alert alert-success" role="alert">
                                                        This order has been <strong>Delivered</strong>.
                                                    </div>
                                                    <%}else if (order.deliveryStatus==='Returned'){%>
                                                        <div class="alert alert-success" role="alert">
                                                            This order has been <strong>Returned</strong>.
                                                        </div>
                                                        <%}%>
                                                        <%}%>
                                </div>
                                <%}%>
        </section>
    </div>


    <script>

        async function updateOrderStatus(event, orderId) {
            event.preventDefault(); // Prevent default form submission

            const form = event.target;
            const status = form.querySelector('select[name="status"]').value;

            try {
                const response = await fetch(`/admin/orders/${orderId}/status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status })
                });

                const result = await response.json();

                if (response.ok) {
                    alert(result.message);
                    window.location.reload();
                } else {
                    alert(result.message || "Failed to update status.");
                }
            } catch (error) {
                console.error("Error updating order status:", error);
                alert("An unexpected error occurred. Please try again.");
            }
        }

        async function updateRetrunOrderStatus(event, orderId) {
            event.preventDefault(); // Prevent default form submission

            const form = event.target;
            const status = form.querySelector('select[name="status"]').value;

            try {
                const response = await fetch(`/admin/orders/retrun/${orderId}/status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status })
                });

                const result = await response.json();

                if (response.ok) {
                    alert(result.message);
                    window.location.reload();
                } else {
                    alert(result.message || "Failed to update status.");
                }
            } catch (error) {
                console.error("Error updating order status:", error);
                alert("An unexpected error occurred. Please try again.");
            }
        }


        function logoutUser() {
            fetch('/api/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin'
                    }
                }).catch(error => {
                })
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
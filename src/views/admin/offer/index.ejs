<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Offers</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="contianer-fluid " style="overflow-x: hidden;">
        <div class="row">
            <section class="col-md-3 col-lg-2   p-3 sidebar">
                <div class="side-bar-heading">
                    <h1>ADMIN</h1>
                </div>
                <div class="side-bar-menu" id="menuId">
                    <div class="link-container">
                        <a href="/admin/dashboard" class="link-text">Dashboard</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/catagoery" class="link-text">Categoery</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/products" class="link-text">Products</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/customers" class="link-text">Customers</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/orders" class="link-text">Orders</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/offers" class="link-text-active">Offers</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Coupons</a>
                    </div>

                    <div class="link-container">
                        <a href="#" class="link-text">Banner</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Transactions</a>
                    </div>
                    <div class="link-container">
                        <a onclick="logoutUser()" class="button-link">Logout</a>
                    </div>
                </div>
            </section>
            <section class="col-md-9 col-lg-10 p-4 container-section">

                <div class="container mt-4">
                    <h2 class="mb-4">Offers Management</h2>

                    <form class="mb-3">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Search offers..." name="search">
                            <button class="btn btn-primary" type="submit">Search</button>
                        </div>
                    </form>

                    <a href="/admin/offers/create-product-offer" class="btn btn-success mb-3">Create Product Offer</a>
                    <a href="/admin/offers/create-product-offer" class="btn btn-success mb-3">Create Catagoery Offer</a>

                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Product/Category Name</th>
                                <th>Type</th>
                                <th>Discount Type</th>
                                <th>Discount Value</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% catagoeryOffers.forEach((offer, index)=> { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= offer.categoryName %>
                                    </td>
                                    <td>Category</td>
                                    <td>
                                        <%= offer.discountType %>
                                    </td>
                                    <td>
                                        <%= offer.discount %>
                                            <%= offer.discountType==='Percentage' ? '%' : '₹' %>
                                    </td>
                                    <td>
                                        <a href="/admin/offers/prodict-update/<%= offer._id %>"
                                            class="btn btn-warning btn-sm">Edit</a>
                                        <a href="/admin/offers/delete/<%= offer._id %>"
                                            class="btn btn-danger btn-sm">Delete</a>
                                    </td>
                                </tr>
                                <% }) %>

                                    <% products.forEach((offer, index)=> { %>
                                        <tr>
                                            <td>
                                                <%= catagoeryOffers.length + index + 1 %>
                                            </td>
                                            <td>
                                                <%= offer.product.product_name %>
                                            </td>
                                            <td>Product</td>
                                            <td>
                                                <%= offer.offer_type %>
                                            </td>
                                            <td>
                                                <%= offer.offer_type==='percentage' ? offer.discountValue + ' %' : '₹ '
                                                    + offer.discountValue %>
                                            </td>
                                            <td>
                                                <a href="/admin/offers/prodict-update/<%= offer._id %>"
                                                    class="btn btn-warning btn-sm">Edit</a>
                                                <button onclick="deleteOffer('<%= offer._id %>')"
                                                    class="btn btn-danger btn-sm">Delete</button>
                                            </td>
                                            </td>
                                        </tr>
                                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>


    <script>

        function logoutUser() {
            fetch('/api/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin'
                    }
                }).catch(error => {
                })
        }

        function deleteOffer(offerId) {
            if (confirm("Are you sure you want to delete this offer?")) {
                fetch(`/admin/offers/prodict-delete/${offerId}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            alert("Offer deleted successfully!");
                            location.reload();
                        } else {
                            alert("Failed to delete the offer.");
                        }
                    })
                    .catch(error => {
                        console.error("Error deleting offer:", error);
                        alert("An error occurred while deleting the offer.");
                    });
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
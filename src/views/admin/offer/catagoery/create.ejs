<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Offers</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="contianer-fluid " style="overflow-x: hidden;">
        <div class="row">
            <section class="col-md-3 col-lg-2   p-3 sidebar">
                <div class="side-bar-heading">
                    <h1>ADMIN</h1>
                </div>
                <div class="side-bar-menu" id="menuId">
                    <div class="link-container">
                        <a href="/admin/dashboard" class="link-text">Dashboard</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/catagoery" class="link-text">Categoery</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/products" class="link-text">Products</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/customers" class="link-text">Customers</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/orders" class="link-text">Orders</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/offers" class="link-text-active">Offers</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Coupons</a>
                    </div>

                    <div class="link-container">
                        <a href="#" class="link-text">Banner</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Transactions</a>
                    </div>
                    <div class="link-container">
                        <a onclick="logoutUser()" class="button-link">Logout</a>
                    </div>
                </div>
            </section>
            <section class="col-md-9 col-lg-10 p-4 container-section">
                <div class="container">
                    <h2>Create Catagoery Offer</h2>
                    <form id="offerForm">
                        <!-- Offer Type -->
                        <div class="mb-3">
                            <label for="offerType" class="form-label">Offer Type</label>
                            <select class="form-select" id="offerType" >
                                <% offerTypes.forEach(function(type) { %>
                                    <option value="<%= type %>">
                                        <%= type==='percentage' ? 'Percentage' : 'Flat Discount' %>
                                    </option>
                                    <% }); %>
                            </select>
                            <div class="invalid-feedback">Please select an offer type.</div>
                        </div>

                        <div class="mb-3">
                            <label for="catagoery" class="form-label">Category</label>
                            <select class="form-select" id="catagoery" >
                                <% catagoery.forEach(function(catagoery) { %>
                                    <option value="<%= catagoery._id %>">
                                        <%= catagoery.catagoery_name %>
                                    </option>
                                    <% }); %>
                            </select>
                            <div class="invalid-feedback">Please select a category.</div>
                        </div>


                        <!-- Discount Value -->
                        <div class="mb-3">
                            <label for="discountValue" class="form-label">Discount Value</label>
                            <input type="number" class="form-control" id="discountValue"  min="0" max="100"
                                placeholder="Enter discount value">
                            <div class="invalid-feedback">Discount value must be between 0 and 20.</div>
                        </div>

                        <!-- Minimum Quantity -->
                        <div class="mb-3">
                            <label for="minQuantity" class="form-label">Minimum Quantity</label>
                            <input type="number" class="form-control" id="minQuantity"  min="1"
                                placeholder="Enter minimum quantity">
                            <div class="invalid-feedback">Minimum quantity must be less than 10.</div>
                        </div>

                        <!-- Maximum Discount -->
                        <div class="mb-3">
                            <label for="maxDiscount" class="form-label">Maximum Discount</label>
                            <input type="number" class="form-control" id="maxDiscount"  min="0"
                                placeholder="Enter maximum discount">
                            <div class="invalid-feedback">Please enter a valid maximum discount.</div>
                        </div>

                        <!-- Valid From Date -->
                        <div class="mb-3">
                            <label for="validFrom" class="form-label">Valid From</label>
                            <input type="date" class="form-control" id="validFrom" >
                            <div class="invalid-feedback">Please select a valid start date.</div>
                        </div>

                        <!-- Valid Until Date -->
                        <div class="mb-3">
                            <label for="validUntil" class="form-label">Valid Until</label>
                            <input type="date" class="form-control" id="validUntil" >
                            <div class="invalid-feedback">Please select a valid end date.</div>
                        </div>

                        <div class="spinner-border text-primary" role="status" id="loading">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <button type="submit" class="btn btn-primary" id="button">Create Offer</button>
                    </form>
                </div>
            </section>
        </div>
    </div>


    <script>

        const loading = document.getElementById('loading')
        const button = document.getElementById('button')
        loading.style.display = 'none'
        
        document.getElementById('offerForm').addEventListener('submit', function (event) {
            event.preventDefault()
            event.stopPropagation()
            let isValid = true;
            let offerType = document.getElementById('offerType').value;
            let catagoery = document.getElementById('catagoery').value;
            let discountValue = document.getElementById('discountValue').value;
            let minQuantity = document.getElementById('minQuantity').value;
            let maxDiscount = document.getElementById('maxDiscount').value;
            let validFrom = document.getElementById('validFrom').value;
            let validUntil = document.getElementById('validUntil').value;

            if (!['percentage', 'flat_discount'].includes(offerType)) {
                document.getElementById('offerType').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('offerType').classList.remove('is-invalid');
            }

            if (!catagoery) {
                document.getElementById('catagoery').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('catagoery').classList.remove('is-invalid');
            }

            if (!discountValue || isNaN(discountValue)) {
                document.getElementById('discountValue').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('discountValue').classList.remove('is-invalid');
            }

            if (!minQuantity || minQuantity > 9) {
                document.getElementById('minQuantity').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('minQuantity').classList.remove('is-invalid');
            }

            if (!maxDiscount || maxDiscount > 20) {
                document.getElementById('maxDiscount').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('maxDiscount').classList.remove('is-invalid');
            }

            if (!validFrom) {
                document.getElementById('validFrom').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('validFrom').classList.remove('is-invalid');
            }

            if (!validUntil || new Date(validUntil) < new Date(validFrom)) {
                document.getElementById('validUntil').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('validUntil').classList.remove('is-invalid');
            }
            if (isValid) {

                const formData = {
                    category_id: catagoery,
                    offer_type: offerType,
                    discountValue: discountValue,
                    min_quantity: minQuantity,
                    max_discount: maxDiscount,
                    valid_from: validFrom,
                    valid_until: validUntil
                };

                loading.style.display = 'flex'
                button.style.display = 'none'
                fetch('/admin/offers/create-catagoery-offer', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(formData),
                })
                    .then(response => response.json())
                    .then(data => {
                        loading.style.display = 'none'
                        button.style.display = 'flex'
                        if (data.redirect) {
                            window.location.href = data.redirect;
                        }
                        if (data.alertType === 'alert-success') {
                            alert(data.message);
                        } else {
                            alert(data.message);
                        }
                    })
                    .catch(error => {
                        loading.style.display = 'none'
                        button.style.display = 'flex'
                        console.error('Error creating offer:', error);
                        alert('An error occurred while creating the offer. Please try again later.');
                    });
            }
        });




    </script>

    <script>



        function logoutUser() {
            fetch('/api/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin'
                    }
                }).catch(error => {
                })
        }

        function deleteOffer(offerId) {
            if (confirm("Are you sure you want to delete this offer?")) {

                fetch(`/admin/offers/prodict-delete/${offerId}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            alert("Offer deleted successfully!");
                            location.reload();
                        } else {
                            alert("Failed to delete the offer.");
                        }
                    })
                    .catch(error => {
                        console.error("Error deleting offer:", error);
                        alert("An error occurred while deleting the offer.");
                    });
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
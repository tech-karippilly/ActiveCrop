<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Offers</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="contianer-fluid " style="overflow-x: hidden;">
        <div class="row">
            <section class="col-md-3 col-lg-2   p-3 sidebar">
                <div class="side-bar-heading">
                    <h1>ADMIN</h1>
                </div>
                <div class="side-bar-menu" id="menuId">
                    <div class="link-container">
                        <a href="/admin/dashboard" class="link-text">Dashboard</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/catagoery" class="link-text">Categoery</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/products" class="link-text">Products</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/customers" class="link-text">Customers</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/orders" class="link-text">Orders</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/offers" class="link-text-active">Offers</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Coupons</a>
                    </div>

                    <div class="link-container">
                        <a href="#" class="link-text">Banner</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Transactions</a>
                    </div>
                    <div class="link-container">
                        <a onclick="logoutUser()" class="button-link">Logout</a>
                    </div>
                </div>
            </section>
            <section class="col-md-9 col-lg-10 p-4 container-section">
                <div class="container">
                    <h2>Edit Referral Offer</h2>
                    <form id="editReferralOfferForm">
                        <!-- Hidden field for Offer ID -->
                        <input type="hidden" id="offerId" value="<%= exsitingOffer._id %>">
            
                        <!-- Title -->
                        <div class="mb-3">
                            <label for="title" class="form-label">Title</label>
                            <input type="text" class="form-control" id="title" placeholder="Enter offer title" value="<%= exsitingOffer.title %>">
                            <div class="invalid-feedback">Please enter a title.</div>
                        </div>
            
                        <!-- Description -->
                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Enter offer description"><%= exsitingOffer.description %></textarea>
                            <div class="invalid-feedback">Please enter a description.</div>
                        </div>
            
                        <!-- Reward Amount -->
                        <div class="mb-3">
                            <label for="rewardAmount" class="form-label">Reward Amount</label>
                            <input type="number" class="form-control" id="rewardAmount" min="1" placeholder="Enter reward amount" value="<%= exsitingOffer.rewardAmount %>">
                            <div class="invalid-feedback">Please enter a valid reward amount (greater than 0).</div>
                        </div>
            
                        <div class="spinner-border text-primary" role="status" id="loading">
                            <span class="visually-hidden">Loading...</span>
                        </div>
            
                        <button type="submit" class="btn btn-primary" id="updateButton">Update Offer</button>
                    </form>
                </div>
            </section>
        </div>
    </div>

    <script>
        const loading = document.getElementById('loading');
        const updateButton = document.getElementById('updateButton');
        loading.style.display = 'none';
    
        document.getElementById('editReferralOfferForm').addEventListener('submit', function (event) {
            event.preventDefault();
            event.stopPropagation();
    
            let isValid = true;
            const offerId = document.getElementById('offerId').value.trim();
            const title = document.getElementById('title').value.trim();
            const description = document.getElementById('description').value.trim();
            const rewardAmount = document.getElementById('rewardAmount').value.trim();
    
            // Validation
            if (!title) {
                document.getElementById('title').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('title').classList.remove('is-invalid');
            }
    
            if (!description) {
                document.getElementById('description').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('description').classList.remove('is-invalid');
            }
    
            if (!rewardAmount || isNaN(rewardAmount) || rewardAmount <= 0) {
                document.getElementById('rewardAmount').classList.add('is-invalid');
                isValid = false;
            } else {
                document.getElementById('rewardAmount').classList.remove('is-invalid');
            }
    
            if (isValid) {
                const formData = { title, description, rewardAmount };
    
                loading.style.display = 'flex';
                updateButton.style.display = 'none';
                const url = window.location.href; 
                const id = url.split("/").pop();
                fetch(`/admin/offers/referal-update/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData),
                })
                    .then(response => response.json())
                    .then(data => {
                        loading.style.display = 'none';
                        updateButton.style.display = 'flex';
                        if (data.redirect) {
                            window.location.href = data.redirect;
                        } else {
                            alert(data.message);
                        }
                    })
                    .catch(error => {
                        loading.style.display = 'none';
                        updateButton.style.display = 'flex';
                        console.error('Error updating referral offer:', error);
                        alert('An error occurred. Please try again.');
                    });
            }
        });
    
        // Function to populate form with existing data
        function loadOfferData(offer) {
            document.getElementById('offerId').value = offer._id;
            document.getElementById('title').value = offer.title;
            document.getElementById('description').value = offer.description;
            document.getElementById('rewardAmount').value = offer.rewardAmount;
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
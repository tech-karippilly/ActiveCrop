<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Offers</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="contianer-fluid " style="overflow-x: hidden;">
        <div class="row">
            <section class="col-md-3 col-lg-2   p-3 sidebar">
                <div class="side-bar-heading">
                    <h1>ADMIN</h1>
                </div>
                <div class="side-bar-menu" id="menuId">
                    <div class="link-container">
                        <a href="/admin/dashboard" class="link-text">Dashboard</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/catagoery" class="link-text">Categoery</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/products" class="link-text">Products</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/customers" class="link-text">Customers</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/orders" class="link-text">Orders</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/offers" class="link-text-active">Offers</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Coupons</a>
                    </div>

                    <div class="link-container">
                        <a href="#" class="link-text">Banner</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Transactions</a>
                    </div>
                    <div class="link-container">
                        <a onclick="logoutUser()" class="button-link">Logout</a>
                    </div>
                </div>
            </section>
            <section class="col-md-9 col-lg-10 p-4 container-section">
                <div class="container">
                    <h2>Create Product Offer</h2>
                    <form id="offerForm">
                        <!-- Offer Type -->
                        <div class="mb-3">
                            <label for="offerType" class="form-label">Offer Type</label>
                            <select class="form-select" id="offerType" required>
                                <% offerTypes.forEach(function(type) { %>
                                    <option value="<%= type %>">
                                        <%= type==='percentage' ? 'Percentage' : 'Flat Discount' %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="product" class="form-label">Catagoery</label>
                            <select class="form-select" id="catagoery" required>
                                <% catagoery.forEach(function(catagoery) { %>
                                    <option value="<%= catagoery._id %>">
                                        <%= catagoery.catagoery_name %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <!-- Product -->
                        <div class="mb-3">
                            <label for="product" class="form-label">Product</label>
                            <select class="form-select" id="product" required>
                                <% products.forEach(function(product) { %>
                                    <option value="<%= product.id %>">
                                        <%= product.product_name %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <!-- Discount Value -->
                        <div class="mb-3">
                            <label for="discountValue" class="form-label">Discount Value</label>
                            <input type="number" class="form-control" id="discountValue" required min="0" max="100"
                                placeholder="Enter discount value (in %)">
                        </div>

                        <!-- Minimum Quantity -->
                        <div class="mb-3">
                            <label for="minQuantity" class="form-label">Minimum Quantity</label>
                            <input type="number" class="form-control" id="minQuantity" required min="1"
                                placeholder="Enter minimum quantity">
                        </div>

                        <!-- Maximum Discount -->
                        <div class="mb-3">
                            <label for="maxDiscount" class="form-label">Maximum Discount</label>
                            <input type="number" class="form-control" id="maxDiscount" required min="0"
                                placeholder="Enter maximum discount">
                        </div>

                        <!-- Valid From Date -->
                        <div class="mb-3">
                            <label for="validFrom" class="form-label">Valid From</label>
                            <input type="date" class="form-control" id="validFrom" required>
                        </div>

                        <!-- Valid Until Date -->
                        <div class="mb-3">
                            <label for="validUntil" class="form-label">Valid Until</label>
                            <input type="date" class="form-control" id="validFrom" required>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary">Create Offer</button>
                    </form>
                </div>
            </section>
        </div>
    </div>
    <script>
        // Initialize date pickers

        document.getElementById('catagoery').addEventListener('change', () => {
            getSelectedCategoryId()
        })

        function getSelectedCategoryId() {
            var selectElement = document.getElementById('catagoery');
            var selectedCategoryId = selectElement.value;
            console.log("Selected Category ID:", selectedCategoryId);
            var url = '/admin/products/catagoery/' + selectedCategoryId + '/products';
            return selectedCategoryId;

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();  // Parse the JSON response
                })
                .then(data => {
                    console.log('Fetched products:', data);
                    // You can now use the 'data' object to display the products
                    displayProducts(data);
                })
                .catch(error => {
                    console.error('There was a problem with the fetch operation:', error);
                });
        }
        function displayProducts(products) {
            var productSelect = document.getElementById('product'); // Get the product select element

            // Clear the existing options (but keep the placeholder if there is one)
            productSelect.innerHTML = '<option value="">Select a product</option>';  // Optional placeholder option

            // Loop through the products and add them to the select dropdown
            products.forEach(function (product) {
                var option = document.createElement('option');
                option.value = product.id;  // Set the option value to the product ID
                option.textContent = product.product_name;  // Set the option text to the product name
                productSelect.appendChild(option);  // Append the option to the select dropdown
            });
        }




        document.addEventListener('DOMContentLoaded', function () {
            const validFrom = document.getElementById('validFrom');
            const validUntil = document.getElementById('validUntil');

            $(validFrom).datepicker({
                format: 'mm/dd/yyyy',
                startDate: new Date(),
                todayHighlight: true
            });
            $(validUntil).datepicker({
                format: 'mm/dd/yyyy',
                startDate: new Date(),
                todayHighlight: true
            });

            // Change discount value placeholder based on offer type selection
            const offerTypeSelect = document.getElementById('offerType');
            const discountValueInput = document.getElementById('discountValue');

            offerTypeSelect.addEventListener('change', function () {
                const offerType = offerTypeSelect.value;

                if (offerType === 'percentage') {
                    discountValueInput.placeholder = 'Enter discount value (in %)';
                } else if (offerType === 'flat_discount') {
                    discountValueInput.placeholder = 'Enter discount value (in currency)';
                } else {
                    discountValueInput.placeholder = 'Enter discount value';
                }
            });

            // Initialize the placeholder on page load based on the default selection
            if (offerTypeSelect.value === 'percentage') {
                discountValueInput.placeholder = 'Enter discount value (in %)';
            } else if (offerTypeSelect.value === 'flat_discount') {
                discountValueInput.placeholder = 'Enter discount value (in currency)';
            }

            // Form submission logic
            const offerForm = document.getElementById('offerForm');
            offerForm.addEventListener('submit', function (e) {
                e.preventDefault();
                if (offerForm.checkValidity() === false) {
                    e.stopPropagation();
                } else {
                    alert('Offer Created Successfully!');
                }
                offerForm.classList.add('was-validated');
            });
        });
    </script>

    <script>



        function logoutUser() {
            fetch('/api/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin'
                    }
                }).catch(error => {
                })
        }

        function deleteOffer(offerId) {
            if (confirm("Are you sure you want to delete this offer?")) {
                fetch(`/admin/offers/prodict-delete/${offerId}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            alert("Offer deleted successfully!");
                            location.reload();
                        } else {
                            alert("Failed to delete the offer.");
                        }
                    })
                    .catch(error => {
                        console.error("Error deleting offer:", error);
                        alert("An error occurred while deleting the offer.");
                    });
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
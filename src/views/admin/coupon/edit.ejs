<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Dashboard</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <section class="side-bar col-3">
                <div class="side-bar-heading">
                    <h1>ADMIN</h1>
                </div>
                <div class="side-bar-menu" id="menuId">
                    <div class="link-container">
                        <a href="/admin/dashboard" class="link-text">Dashboard</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/catagoery" class="link-text">Categoery</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/products" class="link-text">Products</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/customers" class="link-text">Customers</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/orders" class="link-text">Orders</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/offers" class="link-text">Offers</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/coupons" class="link-text-active">Coupons</a>
                    </div>
                    <div class="link-container">
                        <a href="/admin/report" class="link-text">Report</a>
                    </div>
    
                    <div class="link-container">
                        <a href="#" class="link-text">Banner</a>
                    </div>
                    <div class="link-container">
                        <a href="#" class="link-text">Transactions</a>
                    </div>
                    <div class="link-container">
                        <a onclick="logoutUser()" class="button-link">Logout</a>
                    </div>
                </div>
            </section>

            <!-- Main Content Section -->
            <section class="container-section col-9">
                <div class="container mt-4">
                    <h2 class="mb-4">Edit Coupon</h2>

                    <div class="alert alert-success d-none" id="successAlert">Coupon created successfully!</div>
                    <div class="alert alert-danger d-none" id="errorAlert">Failed to create coupon. Please try again.
                    </div>

                    <div class="card p-4 shadow-lg">
                        <form id="createCouponForm">
                            <div class="mb-3">
                                <label for="couponCode" class="form-label">Coupon Code</label>
                                <input type="text" class="form-control" id="couponCode" placeholder="Enter coupon code"
                                    value="<%= existingCoupon.code %>">
                            </div>

                            <div class="mb-3">
                                <label for="discountType" class="form-label">Discount Type</label>
                                <select class="form-control" id="discountType">
                                    <option value="percentage">Percentage</option>
                                    <option value="fixed">Fixed Amount</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="discountValue" class="form-label">Discount Value</label>
                                <input type="number" class="form-control" id="discountValue"
                                    placeholder="Enter discount value" value="<%= existingCoupon.discountValue %>">
                            </div>

                            <div class="mb-3">
                                <label for="minPurchaseAmount" class="form-label">Minimum Purchase Amount</label>
                                <input type="number" class="form-control" id="minPurchaseAmount"
                                    placeholder="Enter min purchase amount"
                                    value="<%= existingCoupon.minPurchaseAmount %>">
                            </div>

                            <div class="mb-3">
                                <label for="maxDiscount" class="form-label">Maximum Discount</label>
                                <input type="number" class="form-control" id="maxDiscount"
                                    placeholder="Enter max discount" value="<%= existingCoupon.maxDiscount %>">
                            </div>

                            <div class="mb-3">
                                <label for="validFrom" class="form-label">Valid From</label>
                                <input type="date" class="form-control" id="validFrom"
                                    value="<%= new Date(existingCoupon.validFrom).toISOString().split('T')[0] %>">
                            </div>

                            <div class="mb-3">
                                <label for="validTo" class="form-label">Valid Until</label>
                                <input type="date" class="form-control" id="validTo"
                                    value="<%= new Date(existingCoupon.validTo).toISOString().split('T')[0] %>">
                            </div>

                            <button type="submit" class="btn btn-success w-100">
                                <span id="btnText">Update Coupon</span>
                                <span id="btnLoader" class="spinner-border spinner-border-sm d-none"></span>
                            </button>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    </div>


    <script>
        document.getElementById("createCouponForm").addEventListener("submit", function (event) {
            event.preventDefault(); // Prevent form submission

            // Get form values
            const couponCode = document.getElementById("couponCode").value.trim();
            const discountType = document.getElementById("discountType").value;
            const discountValue = document.getElementById("discountValue").value.trim();
            const minPurchaseAmount = document.getElementById("minPurchaseAmount").value.trim();
            const maxDiscount = document.getElementById("maxDiscount").value.trim();
            const validFrom = document.getElementById("validFrom").value;
            const validTo = document.getElementById("validTo").value;

            // Basic validation
            if (!couponCode || !discountType || !discountValue || !minPurchaseAmount || !maxDiscount || !validFrom || !validTo) {
                showAlert("errorAlert", "All fields are required!");
                return;
            }

            if (parseFloat(discountValue) <= 0 || parseFloat(minPurchaseAmount) <= 0 || parseFloat(maxDiscount) <= 0) {
                showAlert("errorAlert", "Values must be greater than 0!");
                return;
            }

            if (new Date(validFrom) > new Date(validTo)) {
                showAlert("errorAlert", "Valid From date cannot be later than Valid To date!");
                return;
            }

            // Show loader
            document.getElementById("btnText").classList.add("d-none");
            document.getElementById("btnLoader").classList.remove("d-none");

            // API Call Function
            submitCoupon({
                couponCode,
                discountType,
                discountValue,
                minPurchaseAmount,
                maxDiscount,
                validFrom,
                validTo
            });
        });

        // API Call function
        function submitCoupon(couponData) {
            const id = window.location.pathname.split("/").pop();
            fetch(`/admin/coupons/${id}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(couponData)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.redirect) {
                        showAlert("successAlert", "Coupon Updated successfully!");
                        document.getElementById("createCouponForm").reset();
                        setTimeout(() => {
                            window.location.href = data.redirect
                        }, 2000)
                    } else {
                        showAlert("errorAlert", "Failed to create coupon!");
                    }
                })
                .catch(error => {
                    showAlert("errorAlert", "Error submitting the form. Try again!");
                })
                .finally(() => {
                    // Hide loader
                    document.getElementById("btnText").classList.remove("d-none");
                    document.getElementById("btnLoader").classList.add("d-none");
                });
        }

        // Function to show alert messages
        function showAlert(alertId, message) {
            const alertBox = document.getElementById(alertId);
            alertBox.textContent = message;
            alertBox.classList.remove("d-none");

            setTimeout(() => {
                alertBox.classList.add("d-none");
            }, 3000);
        }
    </script>


    <script>

        function logoutUser() {
            fetch('/api/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin'
                    }
                }).catch(error => {
                })
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
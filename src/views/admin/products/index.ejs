<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Catagoery</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>
    <div class="main-container">
        <section class="side-bar">
            <div class="side-bar-heading">
                <h1>ADMIN</h1>
            </div>
            <div class="side-bar-menu" id="menuId">
                <div class="link-container">
                    <a href="/admin/dashboard" class="link-text">Dashboard</a>
                </div>
                <div class="link-container">
                    <a href="/admin/catagoery" class="link-text">Categoery</a>
                </div>
                <div class="link-container">
                    <a href="/admin/products" class="link-text-active">Products</a>
                </div>
                <div class="link-container">
                    <a href="/admin/customers" class="link-text">Customers</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Orders</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Coupons</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Banner</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Transactions</a>
                </div>
                <div class="link-container">
                    <a href="#" class="button-link">Logout</a>
                </div>
            </div>
        </section>
        <section class="container-section p-5  w-100">
            <div class="alert-box" id="alert-box">
                <% if (alertMessage) { %>
                    <div class="alert alert-<%= alertType %>" id="alert">
                        <%= alertMessage %>
                    </div>
                    <% }%>
                        <div id="alert">

                        </div>
            </div>
            <div class="container-fluid  w-100">
                <div>
                    <h1>List of Products</h1>
                </div>

                <div class="container mt-5">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <form class="form-inline" method="get" action="/admin/products/search">
                                <div class="input-group">
                                    <input class="form-control" type="search" name="searchString" placeholder="Search"
                                        aria-label="Search">
                                    <div class="input-group-append ml-1">
                                        <button class="btn btn-outline-success ml-1" type="submit">Search</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="col-md-6 text-right">
                            <button class="btn button-style"
                                onclick="window.location.href='/admin/products/createProducts'">Create
                                Products</button>
                        </div>
                    </div>
                    <table class="table table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% data.forEach(function(item) { %>
                                <tr>
                                    <td>
                                        <%= item.product_name %>
                                    </td>
                                    <td>
                                        <p style="font-size: 13px;">
                                            <%= item.price%>
                                        </p>
                                    </td>
                                    <td>
                                        <p style="font-size: 13px;">
                                            <%= item.stock_quantity %>
                                        </p>
                                    </td>
                                    <td>
                                        <p class="<%= item.status == 'Available' ? 'text-success' : item.status == 'Blocked' ? 'text-danger' : 'text-muted' %>" style="font-size: 13px;">
                                            <%= item.status %>
                                        </p>
                                    </td>
                                    <td>
                                        <a href="/admin/products/<%= item._id %>"
                                            class="btn btn-warning btn-sm">Edit</a>
                                        <a onclick="deleteCatagoery('<%= item.id %>')"
                                            class="btn btn-danger btn-sm">Delete</a>
                                        <a onclick="blockProduct('<%= item.id %>')"
                                            class="btn btn-danger btn-sm">Block Product</a>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <% if (currentPage> 1) { %>
                                <li class="page-item">
                                    <a class="page-link" href="/admin/products?page=<%= currentPage - 1 %>">Previous</a>
                                </li>
                                <% } %>

                                    <% for (let i=1; i <=totalPages; i++) { %>
                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                            <a class="page-link" href="/admin/products?page=<%= i %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                            <% if (currentPage < totalPages) { %>
                                                <li class="page-item">
                                                    <a class="page-link"
                                                        href="/admin/products?page=<%= currentPage + 1 %>">Next</a>
                                                </li>
                                                <% } %>
                        </ul>
                    </nav>
                </div>
        </section>
    </div>

    <script>
        const alertBox = document.getElementById('alert-box')
        const alertdiv = document.getElementById('alert')

        function deleteCatagoery(id) {
            fetch(`/admin/products/${id}`, {
                method: 'delete'
            })
                .then(response => response.json())
                .then(data => {
                    alertdiv.innerHTML = data.message
                    alertBox.classList.add('alert')
                    if (data.status === 200) {
                        alertBox.classList.add('alert-success')
                        setTimeout(() => {
                            alertdiv.innerHTML = ''
                            alertBox.classList.remove('alert')
                            alertBox.classList.remove('alert-success')
                            window.location.reload()
                        }, 1000)
                    } else {
                        alertBox.classList.add('alert-danger')
                        setTimeout(() => {
                            alertdiv.innerHTML = ''
                            alertBox.classList.remove('alert')
                            alertBox.classList.remove('alert-danger')
                        }, 1000)
                    }

                }).catch(error => {
                    alertdiv.innerHTML = error.message
                    alertBox.classList.add('alert')
                    alertBox.classList.remove('alert-danger')
                    setTimeout(() => {
                        alertdiv.innerHTML = ''
                        alertBox.classList.remove('alert')
                        alertBox.classList.remove('alert-danger')
                    }, 1000)
                })
        }

        function blockProduct(id) {
            fetch(`/admin/products/block/${id}`, {
                method: 'PUT'
            }).then((response) => response.json())
                .then((data) => {
                    console.log(data)
                    if (data.product){
                        window.location.reload()
                    }
                }).catch((error) => {
                    console.log(error.message)
                })
        }

        //         function deleteCatagoery(id) {

        //             fetch(`/api/categoery/${id}`, {
        //                 method: 'delete',
        //             })
        //                 .then(response => response.json())
        //                 .then(data => {

        //                     const alertBox = document.getElementById('alert-box')
        //                     alertBox.innerHTML = `
        // <div class="alert alert-success" id="alert">
        // ${data.message}
        // </div>
        // `;
        //                     setTimeout(() => {
        //                         alertBox.innerHTML = '';
        //                         window.location.href = '/api/products/' // Clear the alert message after 5 seconds
        //                     }, 5000);


        //                 })
        //                 .catch(error => console.error('Error:', error));
        //         }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
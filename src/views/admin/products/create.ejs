<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Product</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">
</head>

<body>


    <div class="main-container">
        <%- include('../../partials/adminSideBar') %>
        <section class="container-section p-5  w-100">

            <div class="container-fluid w-100">
                <div class="alert-box" id="alert-box">
                    <% if (alertMessage) { %>
                        <div class="alert alert-<%= alertType %>" id="alert">
                            <%= alertMessage %>
                        </div>
                        <% }%>
                            <div id="alert">
    
                            </div>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="card p-4 " style="width: 90%">
                        <div class="card-body">
                            <h3 class="card-title text-center">Create Product</h3>
                            <div class="row mb-3" id="image-preview-container">
                                <div class="col">
                                    <div class="img-container">
                                        <img alt="Image" id="croppable-image-one" style="width: 100%; height: 100%;" />
                                    </div>
                                    <button type="button" class="btn btn-primary mt-2" id="crop-button">Crop Image</button>
                                </div>
                                <div class="col">
                                    <div class="img-container">
                                        <img alt="Image" id="croppable-image-two" style="width: 100%; height: 100%;" />
                                    </div>
                                    <button type="button" class="btn btn-primary mt-2" id="crop-button-two">Crop Image</button>
                                </div>
                                <div class="col">
                                    <div class="img-container">
                                        <img alt="Image" id="croppable-image-three" style="width: 100%; height: 100%;" />
                                    </div>
                                    <button type="button" class="btn btn-primary mt-2" id="crop-button-three">Crop Image</button>
                                </div>
                                <div class="col">
                                    <div class="img-container">
                                        <img alt="Image" id="croppable-image-four" style="width: 100%; height: 100%;" />
                                    </div>
                                    <button type="button" class="btn btn-primary mt-2" id="crop-button-four">Crop Image</button>
                                </div>
                            </div>
                           
                            <form id="create-product-form" method="POST" action="/admin/products/createProducts" enctype="multipart/form-data">
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="formFile1" class="form-label">Select Product Image 1</label>
                                        <input class="form-control" type="file" name="product_image" id="formFile1" accept="image/*" >
                                        <span class="text-danger" id="image1-error"></span>
                                    </div>
                                    <div class="col">
                                        <label for="formFile2" class="form-label">Select Product Image 2</label>
                                        <input class="form-control" type="file" name="product_image" id="formFile2" accept="image/*" >
                                        <span class="text-danger" id="image2-error"></span>
                                    </div>
                                    <div class="col">
                                        <label for="formFile3" class="form-label">Select Product Image 3</label>
                                        <input class="form-control" type="file" name="product_image" id="formFile3" accept="image/*" >
                                        <span class="text-danger" id="image3-error"></span>
                                    </div>
                                    <div class="col">
                                        <label for="formFile4" class="form-label">Select Product Image 4</label>
                                        <input class="form-control" type="file" name="product_image" id="formFile4" accept="image/*" >
                                        <span class="text-danger" id="image4-error"></span>
                                    </div>
                                    <span class="text-danger" id="image-error"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="product_name" class="form-label">Product Name</label>
                                    <input type="text" class="form-control" name="product_name" id="product_name" >
                                    <span class="text-danger" id="product-name-error"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="price" class="form-label">Product Price</label>
                                    <input type="text" class="form-control" name="price" id="price" >
                                    <span class="text-danger" id="price-error"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="stock_quantity" class="form-label">Stock Quantity</label>
                                    <input type="text" class="form-control" name="stock_quantity" id="stock_quantity" >
                                    <span class="text-danger" id="stock-quantity-error"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="catagoery">Select Category</label>
                                    <div class="dropdown">
                                        <button class="btn border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="catagoery-name">Select Category</button>
                                        <ul class="dropdown-menu dropdown-menu-dark">
                                            <% data.forEach((catagoery) => { %>
                                                <li><a class="dropdown-item" onclick="selectCategory('<%= catagoery._id %>', '<%= catagoery.catagoery_name %>')">
                                                    <%= catagoery.catagoery_name %>
                                                </a></li>
                                            <% }); %>
                                        </ul>
                                    </div>
                                    <input type="text" class="form-control visually-hidden" name="catagoery_id" id="catagoery_id" >
                                    <span class="text-danger" id="category-error"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" placeholder="Leave description" name="description" id="description" style="height: 100px" ></textarea>
                                        <label for="description">Description</label>
                                    </div>
                                    <span class="text-danger" id="description-error"></span>
                                </div>
                                
                                <div class="btn-container text-center">
                                    <button type="submit" class="btn btn-primary">Create Product</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script>
        handleElementDisplay('image-preview-container','none')
        let cropper, cropper2, cropper3, cropper4;
        const imageInputOne = document.getElementById('formFile1')
        const imageInputTwo = document.getElementById('formFile2')
        const imageInputThree = document.getElementById('formFile3')
        const imageInputFour = document.getElementById('formFile4')

        const croppableImageOne = document.getElementById('croppable-image-one')
        const croppableImagetwo = document.getElementById('croppable-image-two')
        const croppableImagethree = document.getElementById('croppable-image-three')
        const croppableImageFour = document.getElementById('croppable-image-four')
        handleElementDisplay('croppable-image-one','none')
        handleElementDisplay('croppable-image-two','none')
        handleElementDisplay('croppable-image-three','none')
        handleElementDisplay('croppable-image-four','none')
        const cropButton = document.getElementById('crop-button')
        const cropButtonTwo = document.getElementById('crop-button-two')
        const cropButtonThree = document.getElementById('crop-button-three')
        const cropButtonFour = document.getElementById('crop-button-four')

        handleElementDisplay('crop-button','none')
        handleElementDisplay('crop-button-two','none')
        handleElementDisplay('crop-button-three','none')
        handleElementDisplay('crop-button-four','none')

        const reader = new FileReader();

        function handleElementDisplay(elementId,displayType){
            document.getElementById(elementId).style.display=displayType
        }

        imageInputOne.addEventListener('change', (event) => {
            handleElementDisplay('croppable-image-one','flex')
            handleElementDisplay('crop-button','flex')
            handleElementDisplay('image-preview-container','flex')
            const file = event.target.files[0]
            if (file) {
                reader.onload = (e) => {
                    if (e.target.result) {
                        croppableImageOne.src = e.target.result;
                        if (cropper) cropper.destroy();
                        cropper = new Cropper(croppableImageOne, {
                            aspectRatio: 1,
                            viewMode: 2,
                        });
                    }
                }
                reader.readAsDataURL(file);
            }
        })
        cropButton.addEventListener('click', (event) => {
            if (cropper) {
                const croppedCanvas = cropper.getCroppedCanvas({
                    width: 400,
                    height: 400,
                });

                const croppedImageDataUrl = croppedCanvas.toDataURL('image/png');

                const croppedBlob = dataURLToBlob(croppedImageDataUrl);

                const timestamp = Date.now();
                const fileName = `cropped-image-${timestamp}.png`;
                const file = new File([croppedBlob], fileName, { type: 'image/png' });

                const dataTransfer = new DataTransfer();

                dataTransfer.items.add(file);

                imageInputOne.files = dataTransfer.files;

                croppableImageOne.src = croppedImageDataUrl;


                cropButton.style.display = 'none';

                cropper.destroy();
            }
        })
        imageInputTwo.addEventListener('change', (event) => {
            const file = event.target.files[0]
            if (file) {
                handleElementDisplay('croppable-image-two','flex')
                handleElementDisplay('crop-button-two','flex')
                handleElementDisplay('image-preview-container','flex')
                reader.onload = (e) => {
                    if (e.target.result) {
                        croppableImagetwo.src = e.target.result;
                        if (cropper2) cropper2.destroy();
                        cropper2 = new Cropper(croppableImagetwo, {
                            aspectRatio: 1,
                            viewMode: 2,
                        });
                    }
                }
                reader.readAsDataURL(file);
            }
        })
        cropButtonTwo.addEventListener('click', (event) => {
            if (cropper2) {
                const croppedCanvas = cropper2.getCroppedCanvas({
                    width: 400,
                    height: 400,
                });

                const croppedImageDataUrl = croppedCanvas.toDataURL('image/png');

                const croppedBlob = dataURLToBlob(croppedImageDataUrl);

                const timestamp = Date.now();
                const fileName = `cropped-image-${timestamp}.png`;
                const file = new File([croppedBlob], fileName, { type: 'image/png' });

                const dataTransfer = new DataTransfer();

                dataTransfer.items.add(file);

                imageInputTwo.files = dataTransfer.files;

                croppableImagetwo.src = croppedImageDataUrl;


                cropButtonTwo.style.display = 'none';

                cropper2.destroy();
            }
        })
        imageInputThree.addEventListener('change', (event) => {
            const file = event.target.files[0]
            if (file) {
                handleElementDisplay('croppable-image-three','flex')
                handleElementDisplay('crop-button-three','flex')
                handleElementDisplay('image-preview-container','flex')
                reader.onload = (e) => {
                    if (e.target.result) {
                        croppableImagethree.src = e.target.result;
                        if (cropper3) cropper3.destroy();
                        cropper3 = new Cropper(croppableImagethree, {
                            aspectRatio: 1,
                            viewMode: 2,
                        });
                    }
                }
                reader.readAsDataURL(file);
            }
        })
        cropButtonThree.addEventListener('click', (event) => {
            if (cropper3) {
                const croppedCanvas = cropper3.getCroppedCanvas({
                    width: 400,
                    height: 400,
                });

                const croppedImageDataUrl = croppedCanvas.toDataURL('image/png');

                const croppedBlob = dataURLToBlob(croppedImageDataUrl);

                const timestamp = Date.now();
                const fileName = `cropped-image-${timestamp}.png`;
                const file = new File([croppedBlob], fileName, { type: 'image/png' });

                const dataTransfer = new DataTransfer();

                dataTransfer.items.add(file);

                imageInputThree.files = dataTransfer.files;

                croppableImagethree.src = croppedImageDataUrl;


                cropButtonThree.style.display = 'none';

                cropper3.destroy();
            }
        })
        imageInputFour.addEventListener('change', (event) => {
            const file = event.target.files[0]
            if (file) {
                handleElementDisplay('croppable-image-four','flex')
                handleElementDisplay('crop-button-four','flex')
                handleElementDisplay('image-preview-container','flex')
                reader.onload = (e) => {
                    if (e.target.result) {
                        croppableImageFour.src = e.target.result;
                        if (cropper4) cropper4.destroy();
                        cropper4 = new Cropper(croppableImageFour, {
                            aspectRatio: 1,
                            viewMode: 2,
                        });
                    }
                }
                reader.readAsDataURL(file);
            }
        })
        cropButtonFour.addEventListener('click', (event) => {
            if (cropper4) {
                const croppedCanvas = cropper4.getCroppedCanvas({
                    width: 400,
                    height: 400,
                });

                const croppedImageDataUrl = croppedCanvas.toDataURL('image/png');

                const croppedBlob = dataURLToBlob(croppedImageDataUrl);

                const timestamp = Date.now();
                const fileName = `cropped-image-${timestamp}.png`;
                const file = new File([croppedBlob], fileName, { type: 'image/png' });

                const dataTransfer = new DataTransfer();

                dataTransfer.items.add(file);

                imageInputFour.files = dataTransfer.files;

                croppableImageFour.src = croppedImageDataUrl;


                cropButtonFour.style.display = 'none';

                cropper4.destroy();
            }
        })

        const alertBox = document.getElementById('alert-box')
        setTimeout(() => {
            alertBox.classList = '';
            alertBox.innerHTML = '';
        }, 1000);

        const redirectUrl = "<%= redirectUrl %>";
        if (redirectUrl && redirectUrl.trim() !== "") {
            setTimeout(() => {
                window.location.href = redirectUrl;
            }, 1000)

        }
        function selectCategory(categoryId, categoryName) {
            document.getElementById('catagoery-name').innerText = categoryName
            document.getElementById('catagoery_id').value = categoryId
        }

        function dataURLToBlob(dataURL) {
            const binaryString = atob(dataURL.split(',')[1]);
            const length = binaryString.length;
            const bytes = new Uint8Array(length);
            for (let i = 0; i < length; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }
            return new Blob([bytes], { type: 'image/png' });
        }

        document.getElementById('create-product-form').addEventListener('submit', function(event) {
            event.preventDefault()
            event.stopPropagation()
        let isValid = true;

        const productName = document.getElementById('product_name').value.trim();
        const price = document.getElementById('price').value.trim();
        const stockQuantity = document.getElementById('stock_quantity').value.trim();
        const categoryId = document.getElementById('catagoery_id').value.trim();

        const nameRegex = /^[A-Za-z ]+$/;
        if (!nameRegex.test(productName) || productName.startsWith(' ')) {
            document.getElementById('product-name-error').textContent = 'Invalid product name';
            isValid = false;
        } else {
            document.getElementById('product-name-error').textContent = '';
        }

        if (!/^[0-9]+$/.test(price) || parseInt(price) <= 0) {
            document.getElementById('price-error').textContent = 'Price must be a valid number';
            isValid = false;
        } else {
            document.getElementById('price-error').textContent = '';
        }

        if (!/^[0-9]+$/.test(stockQuantity) || parseInt(stockQuantity) <= 0) {
            document.getElementById('stock-quantity-error').textContent = 'Stock quantity must be a valid number';
            isValid = false;
        } else {
            document.getElementById('stock-quantity-error').textContent = '';
        }

        if (categoryId === '') {
            document.getElementById('category-error').textContent = 'Please select a category';
            isValid = false;
        }

        const imageInputs = [
            document.getElementById('formFile1').files.length,
            document.getElementById('formFile2').files.length,
            document.getElementById('formFile3').files.length,
            document.getElementById('formFile4').files.length
        ];
        
        const selectedImages = imageInputs.filter(count => count > 0).length;
        if (selectedImages < 3) {
            document.getElementById('image-error').textContent = 'Please select at least 3 images';
            isValid = false;
        } else {
            document.getElementById('image-error').textContent = '';
        }

        if (!isValid) {
            event.preventDefault();
        }else{
            document.getElementById('create-product-form').submit()
            
        }
    });
        

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
</body>

</html>
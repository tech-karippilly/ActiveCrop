<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Active Crop</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <div class="contianer-fluid " style="overflow-x: hidden;">
        <div class="row">
            <%- include('../../partials/adminSideBar') %>
                <section class="container-section  col-9">
                    <div class="container-fluid mt-5">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="card text-white bg-primary mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title">Total Orders</h5>
                                        <p class="card-text display-6">
                                            <i class="fas fa-shopping-cart"></i>
                                            <%= totalOrders.length> 0 ? totalOrders[0].totalOrders : 0 %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="card text-white bg-warning mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title">Pending Orders</h5>
                                        <p class="card-text display-6">
                                            <i class="fas fa-hourglass-half"></i>
                                            <%= pendingOrders.length> 0 ? pendingOrders[0].totalOrders : 0 %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="card text-white bg-success mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title">Successful Orders</h5>
                                        <p class="card-text display-6">
                                            <i class="fas fa-check-circle"></i>
                                            <%= successOrders.length> 0 ? successOrders[0].totalOrders : 0 %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="card text-white bg-danger mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title">Total Amount</h5>
                                        <p class="card-text display-6">
                                            <i class="fas fa-dollar-sign"></i>
                                            <%= totalAmount.length> 0 ? totalAmount[0].totalAmount.toFixed(2) : '0.00'
                                                %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="card text-white bg-info mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title">Total Discount</h5>
                                        <p class="card-text display-6">
                                            <i class="fas fa-tags"></i>
                                            <%= totalDiscoutAmount.length> 0 ? totalDiscoutAmount[0].discount.toFixed(2)
                                                : '0.00' %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <canvas id="salesChart"></canvas>
                    </div>
                </section>
        </div>

    </div>
    <script>
        const ctx = document.getElementById('salesChart').getContext('2d');

        const salesDataStrings = '<%= JSON.stringify(sales) %>'
        const decodedString = salesDataStrings.replace(/&#34;/g, '"');
        const salesData = JSON.parse(decodedString);

        console.log('salesData',salesData)

        const labels = salesData.map(sale => sale.month);
        const data = salesData.map(sale => sale.totalSales);

        console.log('labels',labels)
        console.log('data',data)

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Sales Amount',
                    data: data,
                    borderColor: 'blue',
                    fill: false
                }]
            }
        });
    </script>

    <script>

        function logoutUser() {
            fetch('/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if (data.ok) {
                        window.location.href = '/admin'
                    }
                }).catch(error => {
                })
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
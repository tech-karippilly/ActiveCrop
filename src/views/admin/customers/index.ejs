<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Customers</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>


    <div class="main-container">
        <%- include('../../partials/adminSideBar') %>
        
        <section class="container-section p-5  w-100">
            <div class="alert-box" id="alert-box">
                <% if (alertMessage) { %>
                    <div class="alert alert-<%= alertType %>" id="alert">
                        <%= alertMessage %>
                    </div>
                    <% } %>
            </div>
            <div class="container-fluid  w-100">
                <div>
                    <h1>List of Customers</h1>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <form class="form-inline" method="get" action="/admin/customers/search">
                            <div class="input-group">
                                <input class="form-control" type="search" name="searchString" placeholder="Search"
                                    aria-label="Search">
                                <div class="input-group-append ml-1">
                                    <button class="btn btn-outline-success ml-1" type="submit">Search</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-6 text-right">
                        <button class="btn button-style"
                            onclick="window.location.href='/admin/customers/create-customer'">Create Customer</button>
                    </div>
                </div>
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>User Name</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% customers.forEach(function(customer) { %>
                            <tr>
                                <td><%= customer.firstName %> <%= customer.lastName %></td>
                                <td><%= customer.email %></td>
                                <td><%=customer.userName  %></td>
                                <td><%= customer.phone %></td>
                                <td>
                                    
                                    <a href="/admin/customers/<%= customer._id %>"   class="btn btn-primary btn-sm">Edit</a>
                                    <a  class="btn btn-danger btn-sm" onclick="deleteUser('<%= customer._id %>')">Delete</a>
                                    <a href="#" id="blockBtn-<%= customer._id %>" class="btn btn-warning btn-sm" onclick="blockUser('<%= customer._id %>', `<%= customer.isBlocked %>`)">
                                        <i class="fas <%= customer.isBlocked ? 'fa-unlock' : 'fa-ban' %>"></i> <%= customer.isBlocked ? 'Unblock' : 'Block' %>
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

        </section>
    </div>


    <script >
        const alertBox = document.getElementById('alert-box')
        setTimeout(() => {
            alertBox.classList = '';
            alertBox.innerHTML = '';
        }, 1000);

        const redirectUrl = "<%= redirectUrl %>";
        if (redirectUrl && redirectUrl.trim() !== "") {
            setTimeout(() => {
                window.location.href = redirectUrl;
            }, 1000)

        }

  
            async function deleteUser(userId) {
            if (!confirm('Are you sure you want to Delete this customer?')) {
                return;
            }

            try {
                const response = await fetch(`/admin/customers/${userId}`, {
                    method: 'delete',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                });

                const data = await response.json();
                const alertBox = document.getElementById('alert-box');
                if (response.ok) {
                    alertBox.innerHTML = `
                        <div class="alert alert-success">
                            ${data.message}
                        </div>
                    `;
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    alertBox.innerHTML = `
                        <div class="alert alert-danger">
                            ${data.message}
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error:', error);
                const alertBox = document.getElementById('alert-box');
                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                    ${error.message}
                    </div>
                `;
            }
        }

        async function blockUser(userId,status) {
            if (!confirm(`Are you sure you want to ${status?'un block':'block'} this customer?`)) {
                return;
            }

            try {
                const response = await fetch(`/admin/customers/${userId}`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                });

                const data = await response.json();
                const alertBox = document.getElementById('alert-box');
                if (response.ok) {
                    alertBox.innerHTML = `
                        <div class="alert alert-success">
                            ${data.message}
                        </div>
                    `;
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    alertBox.innerHTML = `
                        <div class="alert alert-danger">
                            ${data.message}
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error:', error);
                const alertBox = document.getElementById('alert-box');
                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                    ${data.message}
                    </div>
                `;
            }
        }
        function logoutUser() {
            fetch('/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if(data.ok){
                        window.location.href='/admin'
                    }
                }).catch(error => {
                })
        }

    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>
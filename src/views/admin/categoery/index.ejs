<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Catagoery</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <style>
    </style>
</head>


<body>
    <div class="alert-box" id="alert-box">
        <% if (alertMessage) { %>
            <div class="alert alert-<%= alertType %>" id="alert">
                <%= alertMessage %>
            </div>
            <% } %>
    </div>

    <div class="main-container">
        <section class="side-bar col-3">
            <div class="side-bar-heading">
                <h1>ADMIN</h1>
            </div>
            <div class="side-bar-menu" id="menuId">
                <div class="link-container">
                    <a href="/admin/dashboard" class="link-text">Dashboard</a>
                </div>
                <div class="link-container">
                    <a href="/admin/catagoery" class="link-text-active">Categoery</a>
                </div>
                <div class="link-container">
                    <a href="/admin/products" class="link-text">Products</a>
                </div>
                <div class="link-container">
                    <a href="/admin/customers" class="link-text">Customers</a>
                </div>
                <div class="link-container">
                    <a href="/admin/orders" class="link-text">Orders</a>
                </div>
                <div class="link-container">
                    <a href="/admin/offers" class="link-text">Offers</a>
                </div>
                <div class="link-container">
                    <a href="/admin/coupons" class="link-text">Coupons</a>
                </div>
                <div class="link-container">
                    <a href="/admin/report" class="link-text">Report</a>
                </div>

                <div class="link-container">
                    <a href="#" class="link-text">Banner</a>
                </div>
                <div class="link-container">
                    <a href="#" class="link-text">Transactions</a>
                </div>
                <div class="link-container">
                    <a onclick="logoutUser()" class="button-link">Logout</a>
                </div>
            </div>
        </section>
        <section class="container-section p-5  w-100">

            <div class="container-fluid  w-100">
                <div>
                    <h1>List of Categoery</h1>
                </div>

                <div class="container mt-5">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <form class="form-inline"method="get" action="/admin/catagoery/search">
                                <div class="input-group">
                                    <input class="form-control" type="search" name="searchString" placeholder="Search"
                                        aria-label="Search" >
                                    <div class="input-group-append ml-1">
                                        <button class="btn btn-outline-success ml-1" type="submit">Search</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="col-md-6 text-right">
                            <button class="btn button-style"
                                onclick="window.location.href='/admin/catagoery/createCategoery'">Create
                                Categoery</button>
                        </div>
                    </div>
                    <table class="table table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% data.forEach(function(item) { %>
                                <tr>
                                    <td>
                                        <%= item.catagoery_name %>
                                    </td>
                                    <td style="width: 50%;">
                                        <p style="font-size: 13px;">
                                            <%= item.description %>
                                        </p>
                                    </td>
                                    <td>
                                        <a href="/admin/catagoery/<%= item._id %>" class="btn btn-warning btn-sm">Edit</a>
                                        <a onclick="deleteCatagoery('<%= item.id %>')" class="btn btn-danger btn-sm">Delete</a>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>

                </div>

        </section>
    </div>

    <script>
        const alertBox = document.getElementById('alert-box')
        setTimeout(() => {
            alertBox.classList = '';
            alertBox.innerHTML = '';
        }, 1000);

        const redirectUrl = "<%= redirectUrl %>";
        if (redirectUrl && redirectUrl.trim() !== "") {
            setTimeout(() => {
                window.location.href = redirectUrl;
            }, 1000)

        }

        async function deleteCatagoery(id) {

            try {
                const confirmation = confirm('Are you sure you want to delete this category?');
                if (!confirmation) return;

                const response = await fetch(`/admin/catagoery/${id}`, {
                    method: 'DELETE',
                });

                const result = await response.json();

                if (response.ok) {
                    // Show success message and refresh the page
                    alert(result.message);
                    window.location.reload();
                } else {
                    // Show error message
                    alert(result.message || 'Something went wrong. Please try again.');
                }
            } catch (error) {
                console.error('Error deleting category:', error);
                alert('An unexpected error occurred. Please try again.');
            }
        }
        function logoutUser() {
            fetch('/admin/auth/logout', {
                method: 'GET'
            })
                .then((data) => {
                    if(data.ok){
                        window.location.href='/admin'
                    }
                }).catch(error => {
                })
        }
        
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>